# Instalación desatendida de Kali Linux (crear-base.ps1 la genera y Packer la sirve por HTTP)

# Idioma, teclado y zona horaria
d-i debian-installer/locale string {{LOCALE}}
d-i debian-installer/language string {{LANGUAGE}}
d-i debian-installer/country string {{PAIS}}
d-i localechooser/supported-locales multiselect {{LOCALE}}
d-i keyboard-configuration/xkb-keymap select {{TECLADO}}
d-i console-setup/ask_detect boolean false
d-i time/zone string {{ZONA}}
d-i clock-setup/utc boolean true
d-i clock-setup/ntp boolean true

# Red (DHCP de VMware) y nombre
d-i netcfg/choose_interface select auto
d-i netcfg/get_hostname string {{HOSTNAME}}
d-i netcfg/get_domain string local
d-i netcfg/hostname string {{HOSTNAME}}
d-i hw-detect/load_firmware boolean false

# Repositorio de Kali
d-i mirror/country string manual
d-i mirror/protocol string http
d-i mirror/http/hostname string kali.download
d-i mirror/http/directory string /kali
d-i mirror/http/proxy string
d-i mirror/suite string kali-rolling
d-i mirror/codename string kali-rolling
d-i apt-setup/use_mirror boolean true
d-i apt-setup/non-free boolean true
d-i apt-setup/contrib boolean true
d-i apt-setup/disable-cdrom-entries boolean true
# El instalador de Kali no debe usar el CD como fuente de paquetes ni buscar más CD (daba el error
# «Ha fallado el intento de configurar apt para instalar paquetes adicionales desde el medio de instalación»)
d-i apt-setup/cdrom/set-first boolean false
d-i apt-setup/cdrom/set-next boolean false
d-i apt-setup/cdrom/set-failed boolean false
# Kali solo tiene su repositorio: sin los de «security» y «updates» de Debian
d-i apt-setup/services-select multiselect
d-i apt-setup/enable-source-repositories boolean false

# Disco entero, sin preguntar
d-i partman-auto/method string regular
d-i partman-lvm/device_remove_lvm boolean true
d-i partman-md/device_remove_md boolean true
d-i partman-auto/choose_recipe select atomic
d-i partman-partitioning/confirm_write_new_label boolean true
d-i partman/choose_partition select finish
d-i partman/confirm boolean true
d-i partman/confirm_nooverwrite boolean true

# Usuario (con sudo; sin contraseña de root)
d-i passwd/root-login boolean false
d-i passwd/make-user boolean true
d-i passwd/user-fullname string {{USER}}
d-i passwd/username string {{USER}}
d-i passwd/user-password password {{PASS}}
d-i passwd/user-password-again password {{PASS}}
d-i user-setup/allow-password-weak boolean true
d-i user-setup/encrypt-home boolean false

# Aquí solo lo mínimo (SSH, VMware Tools, sudo): el escritorio Xfce y las herramientas de Kali pesan varios GB y
# si el espejo está a medio sincronizar fallan con «Unable to fetch some archives» y rompen toda la instalación.
# Se instalan después, por SSH, con reintentos (packer/kali/herramientas.sh).
tasksel tasksel/first multiselect standard
d-i pkgsel/include string network-manager openssh-server open-vm-tools sudo
d-i pkgsel/upgrade select none
d-i pkgsel/update-policy select none
popularity-contest popularity-contest/participate boolean false

# Preguntas de paquetes de Kali
macchanger macchanger/automatically_run boolean false
wireshark-common wireshark-common/install-setuid boolean true
kismet-capture-common kismet-capture-common/install-setuid boolean true
kismet-capture-common kismet-capture-common/install-users string
sslh sslh/inetd_or_standalone select standalone
samba-common samba-common/dhcp boolean false

# Arranque y fin
d-i grub-installer/only_debian boolean true
d-i grub-installer/with_other_os boolean false
d-i grub-installer/bootdev string default
d-i finish-install/reboot_in_progress note
d-i cdrom-detect/eject boolean true
# Red del sistema instalado: NetworkManager gestiona la tarjeta por DHCP aunque el instalador haya escrito
# /etc/network/interfaces (sin esto, el Kali mínimo se quedaba sin red tras reiniciar y Packer no llegaba por SSH).
# También se deja el nombre del equipo (el instalador lo fija antes de leer este archivo, y quedaba «kali»).
d-i preseed/late_command string in-target systemctl enable ssh; in-target systemctl enable NetworkManager; in-target sh -c 'mkdir -p /etc/NetworkManager/conf.d && printf "[ifupdown]\nmanaged=true\n" > /etc/NetworkManager/conf.d/10-fullcowl.conf'; in-target sh -c 'echo base-kali > /etc/hostname'

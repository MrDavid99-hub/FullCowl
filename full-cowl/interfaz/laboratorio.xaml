<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="PaginaLab">
  <Grid.Resources>
    <Style x:Key="MapaMaq" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource T_acento}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ChipLab" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource T_textoSuave}"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="B" CornerRadius="16" Padding="14,6" Background="{DynamicResource T_superficie}" BorderBrush="{DynamicResource T_borde}" BorderThickness="1">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource T_bordeHover}"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource T_campo}"/>
                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource T_acento}"/>
                <Setter Property="Foreground" Value="{DynamicResource T_texto}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Pestana" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource T_textoSuave}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="B" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="4,8,4,10" Margin="0,0,22,-1" Background="Transparent">
              <ContentPresenter x:Name="C" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource T_acento}"/>
                <Setter TargetName="C" Property="TextElement.Foreground" Value="{DynamicResource T_texto}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource T_acento}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Grid.Resources>
  <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
  </Grid.RowDefinitions>

  <!-- Cabecera -->
  <StackPanel>
    <TextBlock Style="{StaticResource TituloPagina}" Text="Laboratorio"/>
    <TextBlock x:Name="LabResumen" Foreground="{DynamicResource T_textoSuave}" Margin="0,4,0,0" Text="Varias máquinas en la misma red, y las ves conectadas."/>
  </StackPanel>

  <!-- Pestañas -->
  <Border Grid.Row="1" BorderBrush="{DynamicResource T_linea}" BorderThickness="0,0,0,1" Margin="0,14,0,0">
    <StackPanel Orientation="Horizontal">
      <RadioButton x:Name="LabTabMis" Style="{StaticResource Pestana}" GroupName="LabTab" AutomationProperties.Name="Mis laboratorios">
        <StackPanel Orientation="Horizontal">
          <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Ico_Laboratorio}" Width="16" Height="16" Foreground="{DynamicResource T_textoSuave}" Margin="0,0,8,0" VerticalAlignment="Center"/>
          <TextBlock Text="Mis laboratorios" FontWeight="Medium" VerticalAlignment="Center"/>
          <Border Background="{DynamicResource T_campo}" CornerRadius="9" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="LabTabMisNum" Text="0" FontSize="11" FontWeight="SemiBold"/></Border>
        </StackPanel>
      </RadioButton>
      <RadioButton x:Name="LabTabCrear" Style="{StaticResource Pestana}" GroupName="LabTab" AutomationProperties.Name="Crear laboratorio">
        <StackPanel Orientation="Horizontal">
          <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Ico_Nueva}" Width="16" Height="16" Foreground="{DynamicResource T_textoSuave}" Margin="0,0,8,0" VerticalAlignment="Center"/>
          <TextBlock Text="Crear laboratorio" FontWeight="Medium" VerticalAlignment="Center"/>
        </StackPanel>
      </RadioButton>
    </StackPanel>
  </Border>

  <!-- ===== Mis laboratorios ===== -->
  <Grid x:Name="LabMis" Grid.Row="2" Margin="0,18,0,0" Visibility="Collapsed">
    <StackPanel x:Name="LabMisVacio" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,50,0,0" Visibility="Collapsed"/>
    <Grid x:Name="LabMisCuerpo">
      <Grid.ColumnDefinitions><ColumnDefinition Width="262"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,12">
        <StackPanel>
          <StackPanel x:Name="LabListaMis"/>
          <Button x:Name="BtnLabNuevo" Style="{StaticResource BotonSecundario}" Content="+  Nuevo laboratorio" Height="36" Margin="0,4,0,0"/>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="0,0,8,12">
        <ContentControl Style="{StaticResource Tarjeta}" Padding="20,18">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <WrapPanel VerticalAlignment="Center">
                <TextBlock x:Name="LabMTitulo" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource T_texto}" Margin="0,0,12,0"/>
                <TextBlock x:Name="LabMDesc" Foreground="{DynamicResource T_textoSuave}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <WrapPanel x:Name="LabMPildoras" VerticalAlignment="Center"/>
              </WrapPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BtnLmEncTodas" Style="{StaticResource BotonPrimario}" Tag="{StaticResource Ico_Encender}" Content="Encender todas" Height="34" Margin="0,0,8,0"/>
                <Button x:Name="BtnLmApaTodas" Style="{StaticResource BotonSecundario}" Tag="{StaticResource Ico_Apagar}" Content="Apagar todas" Height="34"/>
              </StackPanel>
            </Grid>
            <Border Background="{DynamicResource T_fondo}" BorderBrush="{DynamicResource T_borde}" BorderThickness="1" CornerRadius="12" Margin="0,14,0,0" MinHeight="370">
              <Grid>
                <TextBlock x:Name="LabVerLista" Text="Ver como lista" Foreground="{DynamicResource T_acento}" Cursor="Hand" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,14,0" Panel.ZIndex="5" TextDecorations="Underline"/>
                <ScrollViewer x:Name="LabMapaScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                  <Canvas x:Name="LabMapa" Width="780" Height="370" HorizontalAlignment="Center"/>
                </ScrollViewer>
                <ScrollViewer x:Name="LabMapaListaCaja" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Margin="0,30,0,0" MaxHeight="420">
                  <StackPanel x:Name="LabMapaLista" Margin="14,4,14,10"/>
                </ScrollViewer>
              </Grid>
            </Border>
            <WrapPanel Margin="0,10,0,0">
              <TextBlock Text="●" Foreground="{DynamicResource T_encendida}" Margin="0,0,5,0"/><TextBlock Text="Encendida" Foreground="{DynamicResource T_textoSuave}" FontSize="12" Margin="0,0,14,0"/>
              <TextBlock Text="●" Foreground="{DynamicResource T_pista}" Margin="0,0,5,0"/><TextBlock Text="Apagada" Foreground="{DynamicResource T_textoSuave}" FontSize="12" Margin="0,0,14,0"/>
              <Border Width="18" Height="4" CornerRadius="2" Background="{DynamicResource T_acento}" Margin="0,0,5,0" VerticalAlignment="Center"/><TextBlock Text="Red con Internet" Foreground="{DynamicResource T_textoSuave}" FontSize="12" Margin="0,0,14,0"/>
              <Border Width="18" Height="4" CornerRadius="2" Background="{DynamicResource T_textoSuave}" Margin="0,0,5,0" VerticalAlignment="Center"/><TextBlock Text="Red aislada" Foreground="{DynamicResource T_textoSuave}" FontSize="12" Margin="0,0,14,0"/>
              <TextBlock Text="Haz clic en una máquina para ver sus datos." Foreground="{DynamicResource T_textoSuave}" FontSize="12"/>
            </WrapPanel>
            <Border x:Name="LabFicha" Background="{DynamicResource T_campo}" CornerRadius="12" Padding="16,14" Margin="0,12,0,0">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Border x:Name="LabFSimbolo" Width="44" Height="44" CornerRadius="12" VerticalAlignment="Top" Margin="0,0,14,0"/>
                  <StackPanel Grid.Column="1">
                    <TextBlock x:Name="LabFNombre" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource T_texto}"/>
                    <TextBlock x:Name="LabFSub" Foreground="{DynamicResource T_textoSuave}" FontSize="12.5" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="LabFRed" Foreground="{DynamicResource T_textoSuave}" FontSize="12.5" Margin="0,1,0,0" TextWrapping="Wrap"/>
                  </StackPanel>
                </Grid>
                <WrapPanel Margin="0,12,0,0">
                  <Button x:Name="BtnLmEncender" Style="{StaticResource BotonPrimario}" Content="Encender" Height="32" Margin="0,0,8,6"/>
                  <Button x:Name="BtnLmAbrir" Style="{StaticResource BotonSecundario}" Tag="{StaticResource Ico_Abrir}" Content="Abrir" Height="32" Margin="0,0,8,6"/>
                  <Button x:Name="BtnLmRed" Style="{StaticResource BotonSecundario}" Tag="{StaticResource Ico_Red}" Content="Red…" Height="32" Margin="0,0,8,6"/>
                  <Button x:Name="BtnLmUsuarios" Style="{StaticResource BotonSecundario}" Tag="{StaticResource Ico_Usuarios}" Content="Usuarios…" Height="32" Margin="0,0,8,6"/>
                  <Button x:Name="BtnLmConectar" Style="{StaticResource BotonSecundario}" Tag="{StaticResource Ico_Conectar}" Content="Conectar" Height="32" Margin="0,0,8,6"/>
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border x:Name="LabOpCaja" Visibility="Collapsed" CornerRadius="10" Background="{DynamicResource T_neutro}" Padding="14,10" Margin="0,12,0,0">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock x:Name="LabOpTexto" Foreground="{DynamicResource T_texto}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock x:Name="LabOpReloj" Grid.Column="1" Foreground="{DynamicResource T_textoSuave}" Margin="12,0,0,0"/>
                </Grid>
                <ProgressBar x:Name="LabOpBarra" Style="{StaticResource Progreso}" Minimum="0" Maximum="100" Margin="0,8,0,0"/>
                <TextBlock x:Name="LabOpNota" Style="{StaticResource Nota}" Margin="0,6,0,0" TextWrapping="Wrap" Text="Sigue por su cuenta aunque cierres Full Cowl. No apagues el PC hasta que termine."/>
              </StackPanel>
            </Border>
            <WrapPanel Margin="0,12,0,0">
              <TextBlock Text="Todo el laboratorio:" Foreground="{DynamicResource T_textoSuave}" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,10,6"/>
              <Button x:Name="BtnLmConservar" Style="{StaticResource BotonSecundario}" Tag="&#xE72E;" Content="Conservar" Height="32" Margin="0,0,8,6"/>
              <Button x:Name="BtnLmVolver" Style="{StaticResource BotonSecundario}" Tag="{StaticResource Ico_Deshacer}" Content="Volver al estado inicial" Height="32" Margin="0,0,8,6"/>
              <Button x:Name="BtnLmExportar" Style="{StaticResource BotonSecundario}" Tag="&#xE898;" Content="Exportar…" Height="32" Margin="0,0,8,6"/>
              <Button x:Name="BtnLmMas" Style="{StaticResource BotonSecundario}" Content="···" Height="32" MinWidth="40" Margin="0,0,8,6" ToolTip="Más: guardar el estado de ahora como inicial, quitar el estado inicial" AutomationProperties.Name="Más opciones del estado inicial"/>
              <Button x:Name="BtnLmPlantilla" Style="{StaticResource BotonSecundario}" Tag="&#xE74E;" Content="Exportar como plantilla" Height="32" Margin="0,0,8,6" ToolTip="Guarda la receta del laboratorio (sin discos) en un archivo .fclab para compartirla"/>
              <Button x:Name="BtnLmFicha" Style="{StaticResource BotonSecundario}" Tag="{StaticResource Ico_Ficha}" Content="Ficha del laboratorio" Height="32" Margin="0,0,8,6" ToolTip="Un documento (PDF o texto) con las IP, usuarios y roles de cada máquina, para la memoria de la práctica"/>
              <Button x:Name="BtnLmBorrar" Style="{StaticResource BotonPeligro}" Tag="{StaticResource Ico_Limpiar}" Content="Borrar laboratorio" Height="32" Margin="0,0,8,6"/>
            </WrapPanel>
          </StackPanel>
        </ContentControl>
      </ScrollViewer>
    </Grid>
  </Grid>

  <!-- ===== Crear laboratorio: formulario a la izquierda, vista previa en vivo a la derecha ===== -->
  <Grid x:Name="LabCrear" Grid.Row="2" Margin="0,18,0,0" Visibility="Collapsed">
  <Grid.ColumnDefinitions><ColumnDefinition Width="520"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <ScrollViewer Margin="0,0,-10,0" Padding="0,0,10,0" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="0,2,0,4">
      <!-- Progreso de los laboratorios que se están configurando -->
      <ContentControl x:Name="LabProgCaja" Style="{StaticResource Tarjeta}" Padding="22,18" Margin="0,0,0,18" Visibility="Collapsed">
        <StackPanel>
          <Grid>
            <TextBlock Style="{StaticResource TituloTarjeta}" Text="Configurándose"/>
            <TextBlock Style="{StaticResource Nota}" HorizontalAlignment="Right" Text="Cuando termina un laboratorio, Windows avisa abajo a la derecha"/>
          </Grid>
          <StackPanel x:Name="LabProgLista"/>
        </StackPanel>
      </ContentControl>

      <!-- Laboratorio: nombre, plantilla y opciones -->
      <ContentControl Style="{StaticResource Tarjeta}" Padding="22,18">
        <StackPanel>
          <TextBlock Style="{StaticResource TituloTarjeta}" Text="Laboratorio"/>
          <TextBlock Style="{StaticResource Rotulo}" Text="Nombre"/>
          <TextBox x:Name="LabNombre" Style="{StaticResource Campo}" MaxLength="8" Width="170" HorizontalAlignment="Left"/>
          <TextBlock Style="{StaticResource Nota}" Margin="0,5,0,0" Text="Letras y números, máximo 8. Las máquinas se llaman como el laboratorio (LAB1-WS22-1…)."/>
          <TextBlock Style="{StaticResource Rotulo}" Text="Empezar desde" Margin="0,14,0,0"/>
          <WrapPanel x:Name="LabChips" Margin="0,6,0,0"/>
          <ComboBox x:Name="LabPlantilla" Style="{StaticResource Combo}" Visibility="Collapsed" Width="280" HorizontalAlignment="Left" Margin="0,0,0,8"/>
          <WrapPanel Margin="0,4,0,0">
            <Button x:Name="BtnLabGuardarPl" Style="{StaticResource BotonSecundario}" Tag="&#xE74E;" Content="Guardar como plantilla" Height="32" Margin="0,0,8,0"/>
            <Button x:Name="BtnLabBorrarPl" Style="{StaticResource BotonPeligro}" Tag="{StaticResource Ico_Limpiar}" Content="Borrar plantilla" Height="32" Margin="0,0,8,0"/>
            <Button x:Name="BtnLabPlantillas" Style="{StaticResource BotonSecundario}" Content="Plantillas ▾" Height="32" Margin="0,0,8,0" ToolTip="Exportar o importar plantillas (archivos .fclab)"/>
            <Button x:Name="BtnLabMasPl" Style="{StaticResource BotonSecundario}" Content="···" Height="32" MinWidth="40" Visibility="Collapsed" ToolTip="Exportar, renombrar o borrar la plantilla elegida"/>
          </WrapPanel>
          <WrapPanel Margin="0,14,0,0">
            <CheckBox x:Name="LabDesechable" Style="{StaticResource Casilla}" Content="Desechable: se borra todo al apagar todas sus máquinas" IsChecked="True" Margin="0,0,24,6"/>
            <CheckBox x:Name="LabArrancar" Style="{StaticResource Casilla}" Content="Arrancarlas al terminar" IsChecked="True" Margin="0,0,0,6"/>
          </WrapPanel>
          <CheckBox x:Name="LabEstadoIni" Style="{StaticResource Casilla}" Content="Guardar el estado inicial (recomendado)" IsChecked="True" Margin="0,2,0,0"/>
          <TextBlock x:Name="LabEstadoIniAyuda" Style="{StaticResource Nota}" Margin="26,2,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </ContentControl>

      <!-- Máquinas -->
      <ContentControl Style="{StaticResource Tarjeta}" Padding="22,18" Margin="0,18,0,0">
        <StackPanel>
          <Grid>
            <TextBlock Style="{StaticResource TituloTarjeta}" Text="Máquinas"/>
            <TextBlock x:Name="LabInfo" Style="{StaticResource Nota}" HorizontalAlignment="Right" Margin="0,2,0,0"/>
          </Grid>
          <TextBlock x:Name="LabVacio" Style="{StaticResource Nota}" FontSize="13" Margin="0,10,0,4" TextWrapping="Wrap" Text="Aún no hay máquinas: elige una plantilla arriba o añade una base."/>
          <StackPanel x:Name="LabTipos" Margin="0,10,0,0"/>
          <Button x:Name="BtnLabMas" Style="{StaticResource BotonSecundario}" Tag="{StaticResource Ico_Nueva}" Content="Añadir otra base" Height="32" HorizontalAlignment="Left" Margin="0,4,0,0"/>
          <StackPanel x:Name="LabAnadirPanel" Margin="0,12,0,0">
            <TextBlock Style="{StaticResource Rotulo}" Text="Base"/>
            <ComboBox x:Name="LabBase" Style="{StaticResource Combo}"/>
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
              <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Style="{StaticResource Rotulo}" Text="Cantidad"/>
              <TextBox x:Name="LabCantidad" Style="{StaticResource Campo}" Text="1"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Style="{StaticResource Rotulo}" Text="RAM (MB)"/>
              <TextBox x:Name="LabRam" Style="{StaticResource Campo}" Text="4096"/>
            </StackPanel>
            <StackPanel Grid.Column="4">
              <TextBlock Style="{StaticResource Rotulo}" Text="CPUs"/>
              <TextBox x:Name="LabCpu" Style="{StaticResource Campo}" Text="2"/>
            </StackPanel>
            <StackPanel Grid.Column="6">
              <TextBlock Style="{StaticResource Rotulo}" Text="Vídeo 3D (MB)"/>
              <TextBox x:Name="LabVram" Style="{StaticResource Campo}"/>
            </StackPanel>
            <Button x:Name="BtnLabAnadir" Grid.Column="8" Style="{StaticResource BotonPrimario}" Tag="{StaticResource Ico_Nueva}" Content="Añadir" Height="34" VerticalAlignment="Bottom"/>
          </Grid>

          </StackPanel>
          <TextBlock x:Name="LabVerUna" Style="{StaticResource Nota}" Foreground="{DynamicResource T_acento}" Cursor="Hand" Margin="0,14,0,0" Text="Ver las máquinas una a una ▸"/>
          <StackPanel x:Name="LabUnaAUna" Margin="0,8,0,0" Visibility="Collapsed">
            <Grid MinHeight="60">
            <ListBox x:Name="LabLista" Style="{StaticResource ListaSimple}" SelectionMode="Extended" MaxHeight="320">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Grid.RowSpan="2" Width="30" Height="30" CornerRadius="8" Background="{Binding IconoFondo}" VerticalAlignment="Center">
                      <Grid>
                        <TextBlock Text="{Binding IconoGlifo}" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Path Data="{Binding IconoLogo}" Fill="#FFFFFF" Stretch="Uniform" Width="15" Height="15"/>
                        <Viewbox Width="17" Height="17"><Path Data="{Binding IconoSimbolo}" Stroke="#FFFFFF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="24" Height="24"/></Viewbox>
                      </Grid>
                    </Border>
                    <TextBlock Grid.Column="1" Margin="10,0,10,0" Text="{Binding Nombre}" FontWeight="SemiBold" Foreground="{DynamicResource T_texto}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <Border Grid.Column="2" CornerRadius="10" Padding="9,2" Background="{Binding PapelFondo}" VerticalAlignment="Center">
                      <TextBlock Text="{Binding PapelTexto}" FontSize="11.5" FontWeight="Medium" Foreground="{Binding PapelColor}"/>
                    </Border>
                    <TextBlock Grid.Column="3" Text="{Binding Ip}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource T_textoSuave}" FontSize="12.5"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="10,1,0,0" Text="{Binding Detalle}" FontSize="12" Foreground="{DynamicResource T_textoSuave}" TextTrimming="CharacterEllipsis"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            </Grid>
          <WrapPanel Margin="0,10,0,0">
              <Button x:Name="BtnLabDc" Style="{StaticResource BotonSecundario}" Tag="&#xE7EF;" Content="Hacer controlador" Height="32" Margin="0,0,8,6"/>
              <Button x:Name="BtnLabQuitar" Style="{StaticResource BotonSecundario}" Tag="&#xE738;" Content="Quitar" Height="32" Margin="0,0,8,6"/>
              <Button x:Name="BtnLabVaciar" Style="{StaticResource BotonPeligro}" Tag="{StaticResource Ico_Limpiar}" Content="Vaciar" Height="32" Margin="0,0,8,6"/>
            </WrapPanel>
            <TextBlock Style="{StaticResource Nota}" Margin="0,2,0,0" Text="Ctrl o Mayúsculas + clic: elegir varias · Supr: quitar"/>
          </StackPanel>
        </StackPanel>
      </ContentControl>

      <!-- Red y dominio -->
      <ContentControl Style="{StaticResource Tarjeta}" Padding="22,18" Margin="0,18,0,0">
        <StackPanel>
          <TextBlock Style="{StaticResource TituloTarjeta}" Text="Red y dominio"/>
          <TextBlock Style="{StaticResource Rotulo}" Text="Red"/>
          <WrapPanel x:Name="LabChipsRed" Margin="0,6,0,0"/>
          <TextBlock Style="{StaticResource Rotulo}" Text="Otras redes (puente, otras VMnet, segmentos LAN…)"/>
          <ComboBox x:Name="LabRed" Style="{StaticResource Combo}"/>
          <TextBlock x:Name="LabRedNota" Style="{StaticResource Nota}" Margin="0,5,0,0"/>
          <TextBlock Style="{StaticResource Rotulo}" Text="Direcciones IP" Margin="0,12,0,0"/>
          <WrapPanel Margin="0,6,0,0">
            <RadioButton x:Name="LabDhcp" Style="{StaticResource Opcion}" GroupName="IpLab" Content="Automáticas (DHCP)" IsChecked="True" Margin="0,0,20,4"/>
            <RadioButton x:Name="LabFija" Style="{StaticResource Opcion}" GroupName="IpLab" Content="Fijas, seguidas" Margin="0,0,0,4"/>
          </WrapPanel>
          <TextBlock x:Name="LabVerAvanz" Style="{StaticResource Nota}" Foreground="{DynamicResource T_acento}" Cursor="Hand" Margin="0,14,0,0" Text="Ajustes avanzados de la red ▸"/>
          <StackPanel x:Name="LabAvanzado" Visibility="Collapsed">
          <Grid x:Name="LabIpCampos" Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel>
              <TextBlock Style="{StaticResource Rotulo}" Text="Primera IP"/>
              <TextBox x:Name="LabIp" Style="{StaticResource Campo}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Style="{StaticResource Rotulo}" Text="Prefijo"/>
              <TextBox x:Name="LabPrefijo" Style="{StaticResource Campo}" Text="24"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0">
              <TextBlock Style="{StaticResource Rotulo}" Text="Puerta de enlace"/>
              <TextBox x:Name="LabGw" Style="{StaticResource Campo}"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,10,0,0">
              <TextBlock Style="{StaticResource Rotulo}" Text="DNS (separados por comas)"/>
              <TextBox x:Name="LabDns" Style="{StaticResource Campo}"/>
            </StackPanel>
          </Grid>
          <CheckBox x:Name="LabPing" Style="{StaticResource Casilla}" Content="Permitir ping entre ellas (Windows lo bloquea por defecto)" IsChecked="True" Margin="0,14,0,0"/>
          </StackPanel>

          <Rectangle Height="1" Fill="{DynamicResource T_linea}" Margin="0,16,0,14"/>
          <CheckBox x:Name="LabConDominio" Style="{StaticResource Casilla}" Content="Crear un dominio" FontWeight="Medium"/>
          <Grid x:Name="LabDominioCampos" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Style="{StaticResource Rotulo}" Text="Dominio"/>
              <TextBox x:Name="LabDominio" Style="{StaticResource Campo}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Style="{StaticResource Rotulo}" Text="NetBIOS"/>
              <TextBox x:Name="LabNetbios" Style="{StaticResource Campo}" MaxLength="15"/>
            </StackPanel>
          </Grid>
          <TextBlock x:Name="LabDominioNota" Style="{StaticResource Nota}" Margin="0,8,0,0"/>
        </StackPanel>
      </ContentControl>
    </StackPanel>
  </ScrollViewer>

  <!-- Vista previa en vivo -->
  <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="0,0,8,12">
    <ContentControl Style="{StaticResource Tarjeta}" Padding="20,18">
      <StackPanel>
        <WrapPanel>
          <TextBlock Text="Vista previa" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource T_texto}" Margin="0,0,10,0"/>
          <TextBlock Text="Así quedará conectado. Cambia al tocar cualquier opción." Foreground="{DynamicResource T_textoSuave}" VerticalAlignment="Center" FontSize="12.5"/>
        </WrapPanel>
        <Border Background="{DynamicResource T_fondo}" BorderBrush="{DynamicResource T_borde}" BorderThickness="1" CornerRadius="12" Margin="0,14,0,0">
          <Grid>
            <StackPanel x:Name="LabPrevVacio" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40" Visibility="Collapsed"/>
            <ScrollViewer x:Name="LabPrevScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
              <Canvas x:Name="LabPrevMapa" Width="780" Height="300" HorizontalAlignment="Center"/>
            </ScrollViewer>
          </Grid>
        </Border>
        <!-- Esta máquina: sustituye a la ventana de edición -->
        <Border x:Name="LabPEsta" Background="{DynamicResource T_campo}" CornerRadius="12" Padding="16,14" Margin="0,12,0,0" Visibility="Collapsed">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border x:Name="LabPSimbolo" Width="40" Height="40" VerticalAlignment="Top" Margin="0,0,14,0"/>
              <StackPanel Grid.Column="1">
                <TextBlock x:Name="LabPNombre" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource T_texto}"/>
                <TextBlock x:Name="LabPSub" Foreground="{DynamicResource T_textoSuave}" FontSize="12.5" Margin="0,2,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Grid>
            <CheckBox x:Name="LabPEsDc" Style="{StaticResource Casilla}" Content="Es el controlador del dominio" Margin="0,10,0,0" Visibility="Collapsed"/>
            <UniformGrid Columns="3" Margin="-4,12,-4,0">
              <StackPanel Margin="4,0">
                <TextBlock Style="{StaticResource Rotulo}" Text="Memoria (GB)"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Button x:Name="BtnPRamMenos" Style="{StaticResource BotonSecundario}" Content="−" Width="30" Height="32" Padding="0"/>
                  <TextBox x:Name="LabPRam" Grid.Column="1" Style="{StaticResource Campo}" TextAlignment="Center" Margin="4,0"/>
                  <Button x:Name="BtnPRamMas" Grid.Column="2" Style="{StaticResource BotonSecundario}" Content="+" Width="30" Height="32" Padding="0"/>
                </Grid>
              </StackPanel>
              <StackPanel Margin="4,0">
                <TextBlock Style="{StaticResource Rotulo}" Text="Procesadores"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Button x:Name="BtnPCpuMenos" Style="{StaticResource BotonSecundario}" Content="−" Width="30" Height="32" Padding="0"/>
                  <TextBox x:Name="LabPCpu" Grid.Column="1" Style="{StaticResource Campo}" TextAlignment="Center" Margin="4,0"/>
                  <Button x:Name="BtnPCpuMas" Grid.Column="2" Style="{StaticResource BotonSecundario}" Content="+" Width="30" Height="32" Padding="0"/>
                </Grid>
              </StackPanel>
              <StackPanel Margin="4,0">
                <TextBlock Style="{StaticResource Rotulo}" Text="Vídeo 3D (MB)"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Button x:Name="BtnPVramMenos" Style="{StaticResource BotonSecundario}" Content="−" Width="30" Height="32" Padding="0"/>
                  <TextBox x:Name="LabPVram" Grid.Column="1" Style="{StaticResource Campo}" TextAlignment="Center" Margin="4,0"/>
                  <Button x:Name="BtnPVramMas" Grid.Column="2" Style="{StaticResource BotonSecundario}" Content="+" Width="30" Height="32" Padding="0"/>
                </Grid>
              </StackPanel>
            </UniformGrid>
            <TextBlock x:Name="LabPError" Foreground="{DynamicResource T_aviso}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
            <TextBlock x:Name="LabPNota" Style="{StaticResource Nota}" Margin="0,8,0,0" TextWrapping="Wrap" Text="Solo cambia esta máquina. Haz clic en otra de la vista previa para ajustarla. Vídeo 0 = sin 3D."/>
            <DockPanel x:Name="LabPExtrasFila" Margin="0,10,0,0" LastChildFill="True">
              <Button x:Name="BtnPExtras" DockPanel.Dock="Right" Style="{StaticResource BotonSecundario}" Content="Extras…" Height="30" Margin="10,0,0,0" VerticalAlignment="Center" ToolTip="Software o roles que se instalan solos en el primer arranque de esta máquina"/>
              <TextBlock x:Name="LabPExtras" Style="{StaticResource Nota}" VerticalAlignment="Center" TextWrapping="Wrap" Text="Extras: ninguno"/>
            </DockPanel>
            <Button x:Name="BtnPAplicar" Style="{StaticResource BotonSecundario}" Content="Aplicar a las demás del mismo tipo" Height="32" HorizontalAlignment="Left" Margin="0,10,0,0"/>
          </StackPanel>
        </Border>
        <Grid Margin="0,14,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="LabPResumen" Foreground="{DynamicResource T_textoSuave}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,14,0"/>
          <Button x:Name="BtnCrearLab" Grid.Column="1" Style="{StaticResource BotonPrimario}" Tag="&#xE716;" Content="Crear laboratorio" Height="36"/>
        </Grid>
      </StackPanel>
    </ContentControl>
  </ScrollViewer>
  </Grid>
</Grid>

<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="24,16,24,20">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Grid.ColumnSpan="2" CornerRadius="9" Background="{DynamicResource T_campo}" Padding="12,8" Margin="0,0,0,10">
      <StackPanel Orientation="Horizontal">
        <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Ico_Carpeta}" Width="16" Height="16" Foreground="{DynamicResource T_acento}" VerticalAlignment="Center"/>
        <TextBlock x:Name="CarpetaArch" Style="{StaticResource Nota}" Foreground="{DynamicResource T_texto}" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="400"/>
      </StackPanel>
    </Border>
    <Grid Grid.Row="1" Height="300" Margin="0,0,0,0">
      <ListBox x:Name="ListaArch" Style="{StaticResource ListaSimple}" SelectionMode="Extended"/>
      <TextBlock x:Name="SinArch" Text="El escritorio de la máquina está vacío." Style="{StaticResource Nota}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
    </Grid>
    <StackPanel Grid.Row="1" Grid.Column="1" Margin="14,0,0,0" Width="160">
      <Button x:Name="BtnArchEnviar" Style="{StaticResource BotonPrimario}" Tag="&#xE898;" Content="Enviar a la VM…" Margin="0,0,0,8"/>
      <Button x:Name="BtnArchTraer" Style="{StaticResource BotonSecundario}" Tag="&#xE896;" Content="Traer a mi PC" Margin="0,0,0,8"/>
      <Button x:Name="BtnArchActualizar" Style="{StaticResource BotonSecundario}" Tag="&#xE72C;" Content="Actualizar"/>
    </StackPanel>
    <Border Grid.Row="2" Grid.ColumnSpan="2" Margin="0,14,0,0" CornerRadius="9" Background="{DynamicResource T_infoFondo}" Padding="12,9">
      <TextBlock x:Name="ResArch" Style="{StaticResource Nota}" Foreground="{DynamicResource T_acentoClaro}" Text="«Enviar» copia archivos de tu PC al escritorio de la máquina. «Traer» copia los elegidos de la lista a tu escritorio."/>
    </Border>
  </Grid>
  <Border Grid.Row="1" Background="{DynamicResource T_pie}" BorderBrush="{DynamicResource T_linea}" BorderThickness="0,1,0,0" CornerRadius="0,0,14,14" Padding="24,14">
    <Button x:Name="BtnArchCerrar" Style="{StaticResource BotonSecundario}" Content="Cerrar" MinWidth="104" HorizontalAlignment="Right"/>
  </Border>
</Grid>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Full Cowl" Width="1260" Height="800" MinWidth="1060" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="#F2F6F3" Foreground="#14231A" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Ideal">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Border x:Name="Raiz" Background="{DynamicResource T_fondo}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Menú lateral -->
      <Border x:Name="Menu" Grid.Column="0" Width="248" ClipToBounds="True">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="{DynamicResource K_menuA}" Offset="0"/>
            <GradientStop Color="{DynamicResource K_menuB}" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Margin="12,20,0,0">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="BtnPlegar" Style="{StaticResource BotonLogo}" Width="56" Height="56">
                <Image x:Name="ImgLogo" Width="46" Height="46" RenderOptions.BitmapScalingMode="HighQuality"/>
              </Button>
              <StackPanel x:Name="MenuTitulo" Margin="6,0,0,0" VerticalAlignment="Center">
                <Image x:Name="ImgTitulo" Height="17" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Orientation="Horizontal" Margin="1,5,0,0">
                  <TextBlock x:Name="TxtVersion" Foreground="{DynamicResource T_textoMenu}" FontSize="11"/>
                  <Ellipse x:Name="PuntoAct" Width="7" Height="7" Fill="{DynamicResource T_menuAcento}" Margin="7,1,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </StackPanel>

          <Grid Grid.Row="1" Margin="12,24,12,0">
            <!-- Indicador de la sección activa: se desliza al cambiar -->
            <Border x:Name="NavIndicador" Height="44" VerticalAlignment="Top" CornerRadius="10" Background="{DynamicResource T_menuSel}">
              <Border Width="3" Height="18" HorizontalAlignment="Left" CornerRadius="2" Background="{DynamicResource T_menuAcento}"/>
            </Border>
            <StackPanel>
              <RadioButton x:Name="NavInicio" Style="{StaticResource Nav}" Tag="{StaticResource Ico_Inicio}" Content="Inicio"/>
              <RadioButton x:Name="NavMaq" Style="{StaticResource Nav}" Tag="{StaticResource Ico_Maquinas}" Content="Mis máquinas"/>
              <RadioButton x:Name="NavLab" Style="{StaticResource Nav}" Tag="{StaticResource Ico_Laboratorio}" Content="Laboratorio"/>
              <RadioButton x:Name="NavNueva" Style="{StaticResource Nav}" Tag="{StaticResource Ico_Nueva}" Content="Nueva máquina"/>
              <RadioButton x:Name="NavBase" Style="{StaticResource Nav}" Tag="{StaticResource Ico_Base}" Content="Crear base"/>
              <RadioButton x:Name="NavImportar" Style="{StaticResource Nav}" Tag="{StaticResource Ico_Importar}" Content="Importar"/>
            </StackPanel>
          </Grid>

          <RadioButton x:Name="BtnAjustes" Grid.Row="3" Margin="12,0,12,18" Style="{StaticResource Nav}" GroupName="Ajustes" Tag="{StaticResource Ico_Ajustes}" Content="Ajustes"/>
        </Grid>
      </Border>

      <!-- Zona principal -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="44"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
          <TextBlock x:Name="Migas" Text="Full Cowl  ›  Mis máquinas" Margin="28,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource T_textoSuave}" FontSize="12"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button x:Name="BtnMin" Style="{StaticResource BotonVentana}" Content="&#xE921;"/>
            <Button x:Name="BtnMax" Style="{StaticResource BotonVentana}" Content="&#xE922;"/>
            <Button x:Name="BtnCerrar" Style="{StaticResource BotonCerrar}" Content="&#xE8BB;"/>
          </StackPanel>
        </Grid>

        <!-- Aquí se carga cada página (maquinas.xaml...) -->
        <Grid x:Name="Contenido" Grid.Row="1" Margin="28,4,24,22"/>

        <!-- Aviso flotante (sube desde abajo y se va solo) -->
        <Border x:Name="Toast" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,26" CornerRadius="10" Background="{DynamicResource T_bienvenida}" Padding="16,11" Opacity="0" IsHitTestVisible="False" Panel.ZIndex="10">
          <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.25" Color="#000000"/>
          </Border.Effect>
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="ToastGlifo" Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Foreground="#78EBDD" VerticalAlignment="Center"/>
            <TextBlock x:Name="ToastTexto" Foreground="#F4FBF6" Margin="10,0,0,0" VerticalAlignment="Center" MaxWidth="560" TextWrapping="Wrap"/>
            <TextBlock x:Name="ToastDetalles" Text="Detalles" Foreground="#78EBDD" TextDecorations="Underline" Cursor="Hand" Margin="16,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" AutomationProperties.Name="Ver los detalles del error"/>
            <TextBlock x:Name="ToastCerrar" Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#F4FBF6" Cursor="Hand" Margin="14,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" AutomationProperties.Name="Cerrar el aviso"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">
  <!-- Estilos comunes de la interfaz nueva de Full Cowl. Colores: verde #39824D, turquesa #78EBDD,
       oliva #9C9C54, cabecera #12261A, fondo #F2F6F3, borde #DCE6DF, texto #14231A, suave #5F6F65.
       En los comentarios de este archivo no se pueden poner dos guiones seguidos. -->
<!-- Un icono de linea (StreamGeometry de iconos.xaml) como contenido se pinta sobre una cuadricula de 24 x 24,
     sin relleno, con trazo de 1,8 redondeado. El color es el Foreground del ContentControl que lo contiene. -->
<DataTemplate DataType="{x:Type StreamGeometry}">
  <Viewbox Stretch="Uniform">
    <Canvas Width="24" Height="24">
      <Path Data="{Binding}" Fill="{x:Null}" SnapsToDevicePixels="False"
            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
            StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
    </Canvas>
  </Viewbox>
</DataTemplate>
<Style x:Key="Icono" TargetType="ContentControl">
  <Setter Property="Width" Value="20"/>
  <Setter Property="Height" Value="20"/>
  <Setter Property="Focusable" Value="False"/>
  <Setter Property="IsTabStop" Value="False"/>
  <Setter Property="IsHitTestVisible" Value="False"/>
  <Setter Property="VerticalAlignment" Value="Center"/>
</Style>
<SolidColorBrush x:Key="T_onda" Color="#FFFFFF"/>
<Style x:Key="BotonPrimario" TargetType="Button">
  <Setter Property="Foreground" Value="{DynamicResource T_sobreAcento}"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="Height" Value="38"/>
  <Setter Property="Padding" Value="14,0"/>
  <Setter Property="Cursor" Value="Hand"/>
  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Template">
    <Setter.Value>
      <ControlTemplate TargetType="Button">
        <Grid x:Name="Caja" RenderTransformOrigin="0.5,0.5">
          <Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform>
          <Border CornerRadius="9" Background="{DynamicResource T_acento}"><Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.28" Color="#39824D"/></Border.Effect></Border>
          <Border x:Name="Base" CornerRadius="9" Background="{DynamicResource T_acento}" BorderBrush="{DynamicResource T_acento}" BorderThickness="0"/>
          <Border x:Name="Hov" CornerRadius="9" Background="{DynamicResource T_acentoClaro}" BorderBrush="{DynamicResource T_acentoClaro}" BorderThickness="0" Opacity="0"/>
          <Border x:Name="B" CornerRadius="9" Background="Transparent" BorderThickness="0" Padding="{TemplateBinding Padding}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
              <ContentControl x:Name="Glifo" Content="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource T_sobreAcento}" Width="16" Height="16" HorizontalContentAlignment="Center" Margin="0,0,8,0" VerticalAlignment="Center" Focusable="False" IsTabStop="False"/>
              <ContentPresenter VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <Grid ClipToBounds="True" IsHitTestVisible="False">
            <Ellipse x:Name="Onda" Width="120" Height="120" Fill="{DynamicResource T_onda}" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
              <Ellipse.RenderTransform><ScaleTransform ScaleX="0.1" ScaleY="0.1"/></Ellipse.RenderTransform>
            </Ellipse>
          </Grid>
        </Grid>
        <ControlTemplate.Triggers>
          <EventTrigger RoutedEvent="UIElement.PreviewMouseLeftButtonDown">
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="Onda" Storyboard.TargetProperty="Opacity" From="0.45" To="0" Duration="0:0:0.4"/>
                <DoubleAnimation Storyboard.TargetName="Onda" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.1" To="1.8" Duration="0:0:0.4"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="Onda" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.1" To="1.8" Duration="0:0:0.4"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
              </Storyboard>
            </BeginStoryboard>
          </EventTrigger>
          <Trigger Property="Tag" Value="{x:Null}">
            <Setter TargetName="Glifo" Property="Visibility" Value="Collapsed"/>
          </Trigger>
          <Trigger Property="IsMouseOver" Value="True">
            <Trigger.EnterActions>
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetName="Hov" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                </Storyboard>
              </BeginStoryboard>
            </Trigger.EnterActions>
            <Trigger.ExitActions>
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetName="Hov" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                </Storyboard>
              </BeginStoryboard>
            </Trigger.ExitActions>
          </Trigger>
          <Trigger Property="IsPressed" Value="True">
            <Trigger.EnterActions>
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetName="Caja" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.94" Duration="0:0:0.08"/>
                  <DoubleAnimation Storyboard.TargetName="Caja" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.94" Duration="0:0:0.08"/>
                </Storyboard>
              </BeginStoryboard>
            </Trigger.EnterActions>
            <Trigger.ExitActions>
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetName="Caja" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.18"/>
                  <DoubleAnimation Storyboard.TargetName="Caja" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.18"/>
                </Storyboard>
              </BeginStoryboard>
            </Trigger.ExitActions>
          </Trigger>
          <Trigger Property="IsEnabled" Value="False">
            <Setter TargetName="Caja" Property="Opacity" Value="0.42"/>
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value>
  </Setter>

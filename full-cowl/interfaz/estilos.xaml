              <Setter TargetName="B" Property="Background" Value="{DynamicResource T_infoFondo}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Ojo" Property="Foreground" Value="{DynamicResource T_acento}"/>

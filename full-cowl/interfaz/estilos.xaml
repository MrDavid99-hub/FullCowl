  <!-- Desplegable -->
  <Style x:Key="ItemCombo" TargetType="ComboBoxItem">
    <Setter Property="Padding" Value="10,7"/>
    <Setter Property="Foreground" Value="{DynamicResource T_texto}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="B" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}" Margin="2,1">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="B" Property="Background" Value="{DynamicResource T_infoFondo}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="B" Property="Background" Value="{DynamicResource T_pista}"/>
              <Setter Property="FontWeight" Value="Medium"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Combo" TargetType="ComboBox">
    <Setter Property="Height" Value="34"/>
    <Setter Property="Foreground" Value="{DynamicResource T_texto}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource ItemCombo}"/>
    <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="Boton" Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="B" CornerRadius="8" Background="{DynamicResource T_superficie}" BorderBrush="{DynamicResource T_borde}" BorderThickness="1">
                    <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource T_textoSuave}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource T_bordeHover}"/>
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource T_acento}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter x:Name="Contenido" IsHitTestVisible="False" Margin="11,0,30,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide"
                   IsOpen="{TemplateBinding IsDropDownOpen}">
              <Border Margin="0,4,8,10" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="300"
                      CornerRadius="10" Background="{DynamicResource T_superficie}" BorderBrush="{DynamicResource T_borde}" BorderThickness="1" Padding="3">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.14" Color="#12261A"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsPresenter/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Casilla -->
  <Style x:Key="Casilla" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource T_texto}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="Caja" Width="18" Height="18" CornerRadius="5" Background="{DynamicResource T_superficie}" BorderBrush="{DynamicResource T_bordeFuerte}" BorderThickness="1.5" VerticalAlignment="Center">
              <TextBlock x:Name="Marca" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource T_sobreAcento}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"/>
            </Border>
            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Caja" Property="BorderBrush" Value="{DynamicResource T_acento}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Caja" Property="Background" Value="{DynamicResource T_acento}"/>
              <Setter TargetName="Caja" Property="BorderBrush" Value="{DynamicResource T_acento}"/>
              <Setter TargetName="Marca" Property="Opacity" Value="1"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Opción (una de varias) -->
  <Style x:Key="Opcion" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource T_texto}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Grid Width="18" Height="18" VerticalAlignment="Center">
              <Ellipse x:Name="Aro" Fill="{DynamicResource T_superficie}" Stroke="{DynamicResource T_bordeFuerte}" StrokeThickness="1.5"/>
              <Ellipse x:Name="Punto" Width="8" Height="8" Fill="{DynamicResource T_acento}" Opacity="0"/>
            </Grid>
            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Aro" Property="Stroke" Value="{DynamicResource T_acento}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Aro" Property="Stroke" Value="{DynamicResource T_acento}"/>
              <Setter TargetName="Punto" Property="Opacity" Value="1"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Lista sencilla (instantáneas, archivos) -->
  <Style x:Key="ItemSimple" TargetType="ListBoxItem">
    <Setter Property="Padding" Value="10,7"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="B" CornerRadius="7" Background="Transparent" Padding="{TemplateBinding Padding}" Margin="0,1">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="B" Property="Background" Value="{DynamicResource T_infoFondo}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="B" Property="Background" Value="{DynamicResource T_pista}"/>
              <Setter Property="Foreground" Value="{DynamicResource T_texto}"/>
              <Setter Property="FontWeight" Value="Medium"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ListaSimple" TargetType="ListBox">
    <Setter Property="Background" Value="{DynamicResource T_superficie}"/>
    <Setter Property="Foreground" Value="{DynamicResource T_texto}"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource ItemSimple}"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <Border CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource T_borde}" BorderThickness="1" Padding="4">
            <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto">
              <ItemsPresenter/>
            </ScrollViewer>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Pista emergente oscura -->
  <Style TargetType="ToolTip">
    <Setter Property="Foreground" Value="#F4FBF6"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border CornerRadius="7" Background="{DynamicResource T_bienvenida}" Padding="10,6" Margin="0,0,6,6">
            <Border.Effect>
              <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.25" Color="#000000"/>
            </Border.Effect>
            <ContentPresenter/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Barra de progreso fina y redondeada -->
  <Style x:Key="Progreso" TargetType="ProgressBar">
    <Setter Property="Height" Value="4"/>
    <Setter Property="Foreground" Value="{DynamicResource T_acento}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid>
            <Border x:Name="PART_Track" CornerRadius="2" Background="{DynamicResource T_linea}"/>
            <Border x:Name="PART_Indicator" CornerRadius="2" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" ClipToBounds="True">
              <!-- Franja de luz que recorre lo relleno mientras la tarea está en marcha (la maneja animaciones.ps1) -->
              <Border x:Name="Brillo" HorizontalAlignment="Left" Width="60" Opacity="0" IsHitTestVisible="False">
                <Border.RenderTransform><TranslateTransform X="-400"/></Border.RenderTransform>
              </Border>
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Textos de los diálogos -->
  <Style x:Key="TituloDialogo" TargetType="TextBlock">
    <Setter Property="FontSize" Value="17"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource T_texto}"/>
  </Style>
  <Style x:Key="TituloTarjeta" TargetType="TextBlock">
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource T_texto}"/>
    <Setter Property="Margin" Value="0,0,0,14"/>
  </Style>
  <Style x:Key="TituloPagina" TargetType="TextBlock">
    <Setter Property="FontSize" Value="26"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource T_texto}"/>
  </Style>
  <Style x:Key="Rotulo" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource T_textoSuave}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Margin" Value="0,0,0,5"/>
  </Style>
  <Style x:Key="Nota" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource T_textoSuave}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

    

    <!-- Barras de desplazamiento finas y redondeadas -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8"/>
      <Setter Property="MinWidth" Value="8"/>
      <Setter Property="Margin" Value="4,0,0,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border x:Name="T" CornerRadius="4" Background="{DynamicResource T_esqueleto1}"/>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="T" Property="Background" Value="{DynamicResource T_esqueleto2}"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Tarjeta blanca con sombra suave (la sombra va detrás para que el texto se vea nítido) -->
    <Style x:Key="Tarjeta" TargetType="ContentControl">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContentControl">
            <Grid>
              <Border CornerRadius="14" Background="{DynamicResource T_superficie}">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="18" ShadowDepth="2" Direction="270" Opacity="0.06" Color="#12261A"/>
                </Border.Effect>
              </Border>
              <Border CornerRadius="14" Background="{DynamicResource T_superficie}" BorderBrush="{DynamicResource T_borde}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                <ContentPresenter/>
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Menú lateral -->
    <Style x:Key="Nav" TargetType="RadioButton">
      <Setter Property="Height" Value="44"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
      <Setter Property="Foreground" Value="{DynamicResource T_textoMenu}"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="GroupName" Value="Nav"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="B" CornerRadius="10" Background="Transparent" ClipToBounds="True">
              <Grid>
                <Border x:Name="Hov" CornerRadius="10" Background="#14FFFFFF" Opacity="0"/>
                <!-- Con el menú plegado (botón de 56 px) el icono queda centrado y el texto, fuera del recorte -->
                <ContentControl x:Name="Glifo" Content="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Width="20" Height="20" Margin="18,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" Focusable="False" IsTabStop="False"/>
                <ContentPresenter Margin="56,0,12,0" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Hov" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Hov" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="#F4FBF6"/>
                <Setter TargetName="Glifo" Property="Foreground" Value="{DynamicResource T_menuAcento}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Logo del menú: es el botón de plegar y desplegar -->
    <Style x:Key="BotonLogo" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" CornerRadius="12" Background="#00FFFFFF">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource T_menuHover}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Botones grandes de la pantalla de Inicio (el color lo pone cada uno con Background) -->
    <Style x:Key="BaldosaInicio" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Foreground" Value="#F4FBF6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <!-- Como las tarjetas de «Mis máquinas» y de Ajustes: al pasar el ratón la baldosa sube 2 px y sale una sombra suave
                 (solo cambian la posición y la opacidad). Todo va dentro de «Caja», que se desplaza; el hueco de la tarjeta que la
                 rodea (22 px por arriba y por abajo) deja sitio al levantado y a la sombra sin recortar nada. -->
            <Grid x:Name="Caja">
              <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
              <Border x:Name="SombraHover" CornerRadius="14" Background="{TemplateBinding Background}" Opacity="0">
                <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.28" Color="#000000"/></Border.Effect>
              </Border>
              <Border CornerRadius="14" Background="{TemplateBinding Background}"/>
              <Border x:Name="Brillo" CornerRadius="14" Background="#FFFFFF" Opacity="0"/>
              <Border x:Name="Marco" CornerRadius="14" BorderBrush="#1AFFFFFF" BorderThickness="1" Padding="{TemplateBinding Padding}">
                <ContentPresenter/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Brillo" Property="Opacity" Value="0.1"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="SombraHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"/>
                      <DoubleAnimation Storyboard.TargetName="Caja" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-2" Duration="0:0:0.14">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="SombraHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                      <DoubleAnimation Storyboard.TargetName="Caja" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.2">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Marco" Property="BorderBrush" Value="{DynamicResource T_acento}"/>
                <Setter TargetName="Marco" Property="BorderThickness" Value="2"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Filtros en forma de píldora -->
    <Style x:Key="Chip" TargetType="RadioButton">
      <Setter Property="GroupName" Value="Filtro"/>
      <Setter Property="Foreground" Value="{DynamicResource T_textoSuave}"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="B" CornerRadius="16" Padding="14,6" Background="{DynamicResource T_superficie}" BorderBrush="{DynamicResource T_borde}" BorderThickness="1">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource T_bordeHover}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource T_acento}"/>
                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource T_acento}"/>
                <Setter Property="Foreground" Value="{DynamicResource T_sobreAcento}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Cuadro de búsqueda -->
    <Style x:Key="Busqueda" TargetType="TextBox">
      <Setter Property="Height" Value="38"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{DynamicResource T_texto}"/>
      <Setter Property="CaretBrush" Value="#39824D"/>
      <Setter Property="SelectionBrush" Value="#78EBDD"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="B" CornerRadius="9" Background="{DynamicResource T_superficie}" BorderBrush="{DynamicResource T_borde}" BorderThickness="1">
              <Grid>
                <ContentControl Style="{StaticResource Icono}" Content="{DynamicResource Ico_Buscar}" Width="16" Height="16" Foreground="{DynamicResource T_textoSuave}" Margin="12,0,0,0" HorizontalAlignment="Left"/>
                <TextBlock x:Name="Ph" Text="Buscar máquina, base, IP o etiqueta" Foreground="{DynamicResource T_placeholder}" Margin="36,0,10,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
                <ScrollViewer x:Name="PART_ContentHost" Margin="32,0,10,0" VerticalAlignment="Center" Focusable="False"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Text" Value="">
                <Setter TargetName="Ph" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource T_bordeHover}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource T_acento}"/>
                <Setter TargetName="B" Property="Effect">
                  <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#39824D" Opacity="0.30"/>
                  </Setter.Value>
                </Setter>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Botones de la barra de título (minimizar, maximizar, cerrar) -->
    <Style x:Key="BotonVentana" TargetType="Button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Foreground" Value="{DynamicResource T_textoSuave}"/>
      <Setter Property="Background" Value="#00000000"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource T_ventanaHover}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="BotonCerrar" TargetType="Button" BasedOn="{StaticResource BotonVentana}">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#C42B1C"/>
          <Setter Property="Foreground" Value="#FFFFFF"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Lista de máquinas: cada una es una tarjeta que se eleva al pasar el ratón -->
    <Style x:Key="ListaMaq" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="SelectionMode" Value="Extended"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
      <Setter Property="VirtualizingPanel.IsVirtualizing" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBox">
            <!-- El hueco de arriba va DENTRO de lo que se desplaza (margen del ItemsPresenter): con
                 Padding en el ScrollViewer el recorte empieza más abajo y se comía el borde y la
                 sombra de la primera tarjeta al pasar el ratón o elegirla -->
            <ScrollViewer Focusable="False" Padding="0" VerticalScrollBarVisibility="Auto">
              <ItemsPresenter Margin="2,10,2,6"/>
            </ScrollViewer>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Botón pequeño de la tarjeta (ficha 19): plano, con fondo al pasar el ratón y borde de acento con el foco -->
    <Style x:Key="BotonRapido" TargetType="Button">
      <Setter Property="Width" Value="26"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="Margin" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="True"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Fondo" CornerRadius="6" Background="Transparent" BorderBrush="Transparent" BorderThickness="1.5">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource T_pista}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource T_campo}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Fondo" Property="BorderBrush" Value="{DynamicResource T_acento}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.38"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Fila del menú de clic derecho (ficha 19): texto a la izquierda, fondo suave al pasar el ratón -->
    <Style x:Key="BotonMenuFila" TargetType="Button">
      <Setter Property="Height" Value="32"/>
      <Setter Property="MinWidth" Value="230"/>
      <Setter Property="Foreground" Value="{DynamicResource T_texto}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Fondo" CornerRadius="7" Background="Transparent" BorderBrush="Transparent" BorderThickness="1.5" Padding="10,0">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource T_pista}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Fondo" Property="BorderBrush" Value="{DynamicResource T_acento}"/>
                <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource T_pista}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.42"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ItemMaq" TargetType="ListBoxItem">
      <Setter Property="Margin" Value="{DynamicResource Mq_Margen}"/>
      <Setter Property="Width" Value="{DynamicResource Mq_Ancho}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <!-- Las sombras se dibujan una vez y se guardan como imagen (BitmapCache): al pasar el ratón
                 solo cambia su transparencia, que es lo que hace la animación fluida -->
            <Grid x:Name="Caja">
              <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
              <Border CornerRadius="12" Background="{DynamicResource T_superficie}">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.05" Color="#12261A"/>
                </Border.Effect>
                <Border.CacheMode><BitmapCache/></Border.CacheMode>
              </Border>
              <Border x:Name="SombraHover" CornerRadius="12" Background="{DynamicResource T_superficie}" Opacity="0">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.16" Color="#12261A"/>
                </Border.Effect>
                <Border.CacheMode><BitmapCache/></Border.CacheMode>
              </Border>
              <Border x:Name="Fondo" CornerRadius="12" BorderBrush="{DynamicResource T_borde}" BorderThickness="1"/>
              <Border x:Name="FondoHover" CornerRadius="12" BorderBrush="{DynamicResource T_bordeHover}" BorderThickness="1" Opacity="0"/>
              <Border x:Name="Sel" CornerRadius="12" BorderBrush="{DynamicResource T_acento}" BorderThickness="1.5" Background="#0D39824D" Opacity="0"/>
              <Border x:Name="Marca" Width="4" HorizontalAlignment="Left" Margin="0,16" CornerRadius="0,3,3,0" Background="{DynamicResource T_acento}" Opacity="0"/>
              <ContentPresenter Margin="{DynamicResource Mq_Relleno}"/>
              <!-- Botones rápidos (ficha 19): flotan en la esquina de arriba a la derecha, sin mover nada. Salen al pasar el ratón
                   o con el foco del teclado (IsKeyboardFocusWithin); en pantallas táctiles siempre (Mq_RapidosOpacidad = 1, Mq_RapidosClic = true).
                   Fundido (ficha 25): entran en 120 ms y salen en 90 ms con Storyboard (en XAML, sin PowerShell por evento). Una animación no
                   puede leer un recurso, así que el ajuste «Animaciones» llega por la propiedad ModoRapidos de la fila: Fundido (con
                   Normales y Reducidas), Instante (Ninguna: Setters, sin animar) o Fijo (táctil: siempre a la vista, sin disparadores).
                   Mientras están a 0 no reciben el ratón (IsHitTestVisible), pero sí el foco del teclado. -->
              <Border x:Name="Rapidos" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Padding="2" CornerRadius="8"
                      Background="{DynamicResource T_superficie}" BorderBrush="{DynamicResource T_borde}" BorderThickness="1"
                      Opacity="{DynamicResource Mq_RapidosOpacidad}" IsHitTestVisible="{DynamicResource Mq_RapidosClic}" Visibility="{DynamicResource Mq_VerRapidos}">
                <StackPanel Orientation="Horizontal">
                  <Grid x:Name="GrupoEncApa" Visibility="{DynamicResource Mq_VerRapidoEnc}">
                    <Button x:Name="RapEnc" Tag="Enc" Style="{StaticResource BotonRapido}" ToolTip="Encender" AutomationProperties.Name="Encender">
                      <ContentControl Style="{StaticResource Icono}" Content="{DynamicResource Ico_Encender}" Width="13" Height="13" Foreground="{DynamicResource T_acento}"/>
                    </Button>
                    <Button x:Name="RapApa" Tag="Apa" Style="{StaticResource BotonRapido}" ToolTip="Apagar" AutomationProperties.Name="Apagar" Visibility="Collapsed">
                      <ContentControl Style="{StaticResource Icono}" Content="{DynamicResource Ico_Apagar}" Width="13" Height="13" Foreground="{DynamicResource T_acento}"/>
                    </Button>
                    <Border x:Name="RapOcupado" Width="26" Height="26" Visibility="Collapsed" ToolTip="Trabajando…">
                      <ContentControl x:Name="Rueda" Style="{StaticResource Icono}" Content="{DynamicResource Ico_Actualizar}" Width="13" Height="13" Foreground="{DynamicResource T_acento}" RenderTransformOrigin="0.5,0.5">
                        <ContentControl.RenderTransform><RotateTransform/></ContentControl.RenderTransform>
                      </ContentControl>
                    </Border>
                  </Grid>
                  <Button x:Name="RapIp" Tag="Copiar" Style="{StaticResource BotonRapido}" IsEnabled="{Binding PuedeCopiarIp}" ToolTip="{Binding AyudaIp}" AutomationProperties.Name="Copiar IP">
                    <ContentControl Style="{StaticResource Icono}" Content="{DynamicResource Ico_Copiar}" Width="13" Height="13" Foreground="{DynamicResource T_acento}"/>
                  </Button>
                  <Button x:Name="RapCon" Tag="Conectar" Style="{StaticResource BotonRapido}" IsEnabled="{Binding PuedeConectar}" ToolTip="{Binding AyudaConectar}" AutomationProperties.Name="Conectar">
                    <ContentControl Style="{StaticResource Icono}" Content="{DynamicResource Ico_Conectar}" Width="13" Height="13" Foreground="{DynamicResource T_acento}"/>
                  </Button>
                </StackPanel>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding ModoRapidos}" Value="Fundido"/>
                  <Condition Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                  <Condition Binding="{Binding Path=IsKeyboardFocusWithin, RelativeSource={RelativeSource TemplatedParent}}" Value="False"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="Rapidos" Property="IsHitTestVisible" Value="True"/>
                <MultiDataTrigger.EnterActions>
                  <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Rapidos" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/></Storyboard></BeginStoryboard>
                </MultiDataTrigger.EnterActions>
                <MultiDataTrigger.ExitActions>
                  <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Rapidos" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.09" FillBehavior="Stop"/></Storyboard></BeginStoryboard>
                </MultiDataTrigger.ExitActions>
              </MultiDataTrigger>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding ModoRapidos}" Value="Fundido"/>
                  <Condition Binding="{Binding Path=IsKeyboardFocusWithin, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="Rapidos" Property="IsHitTestVisible" Value="True"/>
                <MultiDataTrigger.EnterActions>
                  <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Rapidos" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/></Storyboard></BeginStoryboard>
                </MultiDataTrigger.EnterActions>
                <MultiDataTrigger.ExitActions>
                  <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Rapidos" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.09" FillBehavior="Stop"/></Storyboard></BeginStoryboard>
                </MultiDataTrigger.ExitActions>
              </MultiDataTrigger>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding ModoRapidos}" Value="Instante"/>
                  <Condition Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="Rapidos" Property="Opacity" Value="1"/>
                <Setter TargetName="Rapidos" Property="IsHitTestVisible" Value="True"/>
              </MultiDataTrigger>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding ModoRapidos}" Value="Instante"/>
                  <Condition Binding="{Binding Path=IsKeyboardFocusWithin, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="Rapidos" Property="Opacity" Value="1"/>
                <Setter TargetName="Rapidos" Property="IsHitTestVisible" Value="True"/>
              </MultiDataTrigger>
              <DataTrigger Binding="{Binding Encendida}" Value="True">
                <Setter TargetName="RapEnc" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="RapApa" Property="Visibility" Value="Visible"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding EsBase}" Value="True">
                <Setter TargetName="GrupoEncApa" Property="Visibility" Value="Collapsed"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding Trabajando}" Value="True">
                <Setter TargetName="RapEnc" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="RapApa" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="RapOcupado" Property="Visibility" Value="Visible"/>
                <DataTrigger.EnterActions>
                  <BeginStoryboard x:Name="GiroRapido">
                    <Storyboard RepeatBehavior="Forever">
                      <DoubleAnimation Storyboard.TargetName="Rueda" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:0.9"/>
                    </Storyboard>
                  </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                  <StopStoryboard BeginStoryboardName="GiroRapido"/>
                </DataTrigger.ExitActions>
              </DataTrigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="FondoHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"/>
                      <DoubleAnimation Storyboard.TargetName="SombraHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"/>
                      <DoubleAnimation Storyboard.TargetName="Caja" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-2" Duration="0:0:0.14">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="FondoHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                      <DoubleAnimation Storyboard.TargetName="SombraHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                      <DoubleAnimation Storyboard.TargetName="Caja" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.2">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                      <DoubleAnimation Storyboard.TargetName="Marca" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                      <DoubleAnimation Storyboard.TargetName="Marca" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Mis máquinas: medidas que cambian con la vista y el tamaño (los pone Aplicar-VistaMaquinas en los recursos
         de la aplicación; estos son los de «Tarjetas · Normal») ===== -->
    <system:Double x:Key="Mq_Ancho">NaN</system:Double>
    <Thickness x:Key="Mq_Margen">2,0,2,8</Thickness>
    <Thickness x:Key="Mq_Relleno">14,11,16,11</Thickness>
    <Thickness x:Key="Mq_MargenTitulo">12,0,0,0</Thickness>
    <system:Double x:Key="Mq_Circulo">38</system:Double>
    <system:Double x:Key="Mq_AnchoRed">100</system:Double>
    <Thickness x:Key="Mq_PadLogo">9</Thickness>
    <system:Double x:Key="Mq_FuenteGlifo">17</system:Double>
    <system:Double x:Key="Mq_Alto">NaN</system:Double>
    <Visibility x:Key="Mq_VerDetalle">Visible</Visibility>
    <Visibility x:Key="Mq_VerBotones">Collapsed</Visibility>
    <!-- Botones rápidos de la tarjeta (ficha 19): Mq_VerRapidos = los tres; Mq_VerRapidoEnc = solo Encender/Apagar (en «Grande» ya hay
         botones abajo); Mq_RapidosOpacidad = 0 (salen al pasar el ratón o con el foco) o 1 (pantallas táctiles: siempre) -->
    <Visibility x:Key="Mq_VerRapidos">Visible</Visibility>
    <Visibility x:Key="Mq_VerRapidoEnc">Visible</Visibility>
    <system:Double x:Key="Mq_RapidosOpacidad">0</system:Double>
    <system:Boolean x:Key="Mq_RapidosClic">False</system:Boolean>
    <!-- Fundido o instante del borde de las tarjetas de Ajustes (ficha 25): los pone Aplicar-Tema según el ajuste Animaciones -->
    <Visibility x:Key="Anim_VerFundido">Visible</Visibility>
    <Visibility x:Key="Anim_VerInstante">Collapsed</Visibility>
    <ItemsPanelTemplate x:Key="PanelTarjetas"><WrapPanel/></ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="PanelFila"><StackPanel/></ItemsPanelTemplate>


    <!-- Etiquetas y nota de cada máquina (ficha 18) -->
    <Style x:Key="BotonQuitarEtq" TargetType="Button">
      <Setter Property="Width" Value="18"/>
      <Setter Property="Height" Value="18"/>
      <Setter Property="Margin" Value="3,0,0,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Fondo" CornerRadius="9" Background="Transparent" BorderBrush="Transparent" BorderThickness="1.5">
              <ContentControl Style="{StaticResource Icono}" Content="{DynamicResource Ico_Cerrar}" Width="8" Height="8" Foreground="{DynamicResource T_acentoClaro}" HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource T_campo}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Fondo" Property="BorderBrush" Value="{DynamicResource T_acento}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="BotonSugerirEtq" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Foreground" Value="{DynamicResource T_textoSuave}"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Margin" Value="0,0,5,5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Fondo" CornerRadius="11" Background="Transparent" BorderBrush="{DynamicResource T_borde}" BorderThickness="1" Padding="8,2,8,3">
              <ContentPresenter x:Name="Texto" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Fondo" Property="BorderBrush" Value="{DynamicResource T_acento}"/>
                <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource T_pista}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Fondo" Property="BorderBrush" Value="{DynamicResource T_acento}"/>
                <Setter TargetName="Fondo" Property="BorderThickness" Value="2"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Las etiquetas (como mucho 2 y un «+N») y el icono de la nota que salen en la tarjeta y en la fila de cada máquina -->
    <DataTemplate x:Key="EtqYNota">
      <StackPanel x:Name="Raiz" Orientation="Horizontal" Visibility="Collapsed">
        <ItemsControl ItemsSource="{Binding EtqVisibles}" Focusable="False" IsTabStop="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,5,0" Padding="8,1,8,2" CornerRadius="9" Background="{DynamicResource T_pista}">
                <TextBlock Text="{Binding}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource T_acentoClaro}" TextTrimming="CharacterEllipsis" MaxWidth="110"/>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border x:Name="IcoNota" Visibility="Collapsed" Background="Transparent" VerticalAlignment="Center" Padding="2">
          <Border.ToolTip>
            <ToolTip Content="{Binding Nota}" MaxWidth="340">
              <ToolTip.ContentTemplate>
                <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate>
              </ToolTip.ContentTemplate>
            </ToolTip>
          </Border.ToolTip>
          <ContentControl Style="{StaticResource Icono}" Content="{DynamicResource Ico_Documento}" Width="13" Height="13" Foreground="{DynamicResource T_textoSuave}"/>
        </Border>
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding TieneEtqONota}" Value="True">
          <Setter TargetName="Raiz" Property="Visibility" Value="Visible"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding TieneNota}" Value="True">
          <Setter TargetName="IcoNota" Property="Visibility" Value="Visible"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Contenido de cada máquina en vista de TARJETAS (el tamaño sale de los Mq_*) -->
    <DataTemplate x:Key="PlantillaMaqTarjeta">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Width="{DynamicResource Mq_Circulo}" Height="{DynamicResource Mq_Circulo}" CornerRadius="10" Background="{Binding IconoFondo}" Padding="{DynamicResource Mq_PadLogo}" VerticalAlignment="Top">
          <Grid>
            <TextBlock Text="{Binding IconoGlifo}" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource Mq_FuenteGlifo}" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Viewbox Stretch="Uniform"><Path Data="{Binding IconoLogo}" Fill="#FFFFFF" Stretch="Uniform" Width="20" Height="20"/></Viewbox>
            <Viewbox Stretch="Uniform"><Path Data="{Binding IconoSimbolo}" Stroke="#FFFFFF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="24" Height="24"/></Viewbox>
          </Grid>
        </Border>
        <StackPanel Grid.Column="1" Margin="{DynamicResource Mq_MargenTitulo}" VerticalAlignment="Center">
          <!-- Mq_MargenTitulo deja a la derecha el sitio de los botones rápidos (si no, taparían BASE/FC con nombres largos). WrapPanel: si el nombre es largo se recorta con «…» y las etiquetas (BASE, FC, DESECHABLE) bajan a la línea de abajo en vez de salirse por la derecha -->
          <WrapPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Nombre}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource T_texto}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            <Border x:Name="EtqBase" Visibility="Collapsed" Margin="8,0,0,0" Padding="7,1" CornerRadius="6" Background="{DynamicResource T_pista}" VerticalAlignment="Center">
              <TextBlock Text="BASE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource T_acentoClaro}"/>
            </Border>
            <Border x:Name="EtqFc" Visibility="Collapsed" Margin="8,0,0,0" Padding="7,1" CornerRadius="6" Background="{DynamicResource T_pista}" VerticalAlignment="Center" ToolTip="Máquina creada con Full Cowl">
              <TextBlock Text="FC" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource T_acentoClaro}"/>
            </Border>
            <Border x:Name="EtqDesech" Grid.Column="3" Visibility="Collapsed" Margin="6,0,8,0" Padding="7,1" CornerRadius="6" Background="{DynamicResource T_avisoFondo}" VerticalAlignment="Center">
              <TextBlock Text="DESECHABLE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource T_aviso}"/>
            </Border>
          </WrapPanel>
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <Grid Width="8" Height="8" VerticalAlignment="Center">
              <Ellipse x:Name="Halo" Fill="{Binding EstadoColor}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
              </Ellipse>
              <Ellipse Fill="{Binding EstadoColor}"/>
            </Grid>
            <TextBlock Text="{Binding EstadoTexto}" Margin="7,0,0,0" FontSize="12" FontWeight="Medium" Foreground="{Binding EstadoColor}"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Visibility="{DynamicResource Mq_VerDetalle}">
          <TextBlock Text="{Binding LineaCorta}" Foreground="{DynamicResource T_textoSuave}" FontSize="12" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/>
          <ContentControl Content="{Binding}" ContentTemplate="{StaticResource EtqYNota}" Margin="0,6,0,0" Focusable="False" IsTabStop="False"/>
        </StackPanel>
        <ProgressBar x:Name="BarraConf" Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource Progreso}" Value="{Binding Progreso, Mode=OneWay}" Foreground="{Binding EstadoColor}" Margin="0,8,0,0" Visibility="Collapsed"/>
        <Grid x:Name="BotonesTarjeta" Grid.Row="3" Grid.ColumnSpan="2" Margin="0,12,0,0" Visibility="{DynamicResource Mq_VerBotones}">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Button x:Name="BtnTEnc" Tag="Enc" Style="{StaticResource BotonPrimario}" Height="30" FontSize="12" Padding="8,0">
            <TextBlock Text="Encender"/>
          </Button>
          <Button x:Name="BtnTApa" Tag="Apa" Style="{StaticResource BotonSecundario}" Height="30" FontSize="12" Padding="8,0" Visibility="Collapsed">
            <TextBlock Text="Apagar"/>
          </Button>
          <Button Tag="Abrir" Grid.Column="2" Style="{StaticResource BotonSecundario}" Height="30" FontSize="12" Padding="8,0">
            <TextBlock Text="Abrir"/>
          </Button>
        </Grid>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding EsBase}" Value="True">
          <Setter TargetName="EtqBase" Property="Visibility" Value="Visible"/>
          <Setter TargetName="BotonesTarjeta" Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Configurando}" Value="True">
          <Setter TargetName="BarraConf" Property="Visibility" Value="Visible"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding EsFc}" Value="True">
          <Setter TargetName="EtqFc" Property="Visibility" Value="Visible"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding EsDesechable}" Value="True">
          <Setter TargetName="EtqDesech" Property="Visibility" Value="Visible"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Encendida}" Value="True">
          <Setter TargetName="BtnTEnc" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="BtnTApa" Property="Visibility" Value="Visible"/>
          <DataTrigger.EnterActions>
            <BeginStoryboard x:Name="Latido">
              <Storyboard RepeatBehavior="Forever">
                <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="Opacity" From="0.6" To="0" Duration="0:0:1.4"/>
                <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1" To="2.6" Duration="0:0:1.4"/>
                <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="2.6" Duration="0:0:1.4"/>
              </Storyboard>
            </BeginStoryboard>
          </DataTrigger.EnterActions>
          <DataTrigger.ExitActions>
            <StopStoryboard BeginStoryboardName="Latido"/>
          </DataTrigger.ExitActions>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Contenido de cada máquina en vista de LISTA (una fila por máquina; las columnas van con la cabecera de maquinas.xaml) -->
    <DataTemplate x:Key="PlantillaMaqFila">
      <Grid Height="{DynamicResource Mq_Alto}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="200"/>
          <ColumnDefinition Width="140"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="130"/>
          <ColumnDefinition Width="80"/>
          <ColumnDefinition Width="44"/>
        </Grid.ColumnDefinitions>
        <Grid VerticalAlignment="Center">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border Width="{DynamicResource Mq_Circulo}" Height="{DynamicResource Mq_Circulo}" CornerRadius="8" Background="{Binding IconoFondo}" Padding="{DynamicResource Mq_PadLogo}">
            <Grid>
              <TextBlock Text="{Binding IconoGlifo}" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource Mq_FuenteGlifo}" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <Viewbox Stretch="Uniform"><Path Data="{Binding IconoLogo}" Fill="#FFFFFF" Stretch="Uniform" Width="20" Height="20"/></Viewbox>
            <Viewbox Stretch="Uniform"><Path Data="{Binding IconoSimbolo}" Stroke="#FFFFFF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="24" Height="24"/></Viewbox>
            </Grid>
          </Border>
          <TextBlock Grid.Column="1" Text="{Binding Nombre}" Margin="12,0,0,0" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource T_texto}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
          <Border x:Name="EtqBase" Grid.Column="2" Visibility="Collapsed" Margin="8,0,8,0" Padding="7,1" CornerRadius="6" Background="{DynamicResource T_pista}" VerticalAlignment="Center">
            <TextBlock Text="BASE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource T_acentoClaro}"/>
          </Border>
          <Border x:Name="EtqFc" Visibility="Collapsed" Margin="8,0,8,0" Padding="7,1" CornerRadius="6" Background="{DynamicResource T_pista}" VerticalAlignment="Center" ToolTip="Máquina creada con Full Cowl" Grid.Column="2">
            <TextBlock Text="FC" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource T_acentoClaro}"/>
          </Border>
          <Border x:Name="EtqDesech" Grid.Column="3" Visibility="Collapsed" Margin="0,0,0,0" Padding="7,1" CornerRadius="6" Background="{DynamicResource T_avisoFondo}" VerticalAlignment="Center">
            <TextBlock Text="DESECHABLE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource T_aviso}"/>
          </Border>
          <ContentControl Grid.Column="4" Content="{Binding}" ContentTemplate="{StaticResource EtqYNota}" Margin="8,0,0,0" VerticalAlignment="Center" Focusable="False" IsTabStop="False"/>
        </Grid>
        <TextBlock Grid.Column="1" Text="{Binding Familia}" Foreground="{DynamicResource T_textoSuave}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
        <Border Grid.Column="2" Width="{DynamicResource Mq_AnchoRed}" ClipToBounds="True" VerticalAlignment="Center">
          <TextBlock Text="{Binding Red}" Foreground="{DynamicResource T_textoSuave}" FontSize="12.5" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
        </Border>
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
          <Grid Width="8" Height="8" VerticalAlignment="Center">
            <Ellipse x:Name="Halo" Fill="{Binding EstadoColor}" Opacity="0" RenderTransformOrigin="0.5,0.5">
              <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Fill="{Binding EstadoColor}"/>
          </Grid>
          <TextBlock Text="{Binding EstadoTexto}" Margin="7,0,0,0" FontSize="12.5" FontWeight="Medium" Foreground="{Binding EstadoColor}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <TextBlock Grid.Column="4" Text="{Binding Ram}" Foreground="{DynamicResource T_textoSuave}" FontSize="12.5" VerticalAlignment="Center" TextWrapping="NoWrap"/>
        <Grid x:Name="BotonRapido" Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="BtnTEnc" Tag="Enc" Style="{StaticResource BotonSecundario}" Width="34" Height="28" Padding="0" ToolTip="Encender">
            <ContentControl Style="{StaticResource Icono}" Content="{DynamicResource Ico_Encender}" Width="14" Height="14" Foreground="{DynamicResource T_acento}"/>
          </Button>
          <Button x:Name="BtnTApa" Tag="Apa" Style="{StaticResource BotonSecundario}" Width="34" Height="28" Padding="0" ToolTip="Apagar" Visibility="Collapsed">
            <ContentControl Style="{StaticResource Icono}" Content="{DynamicResource Ico_Apagar}" Width="14" Height="14" Foreground="{DynamicResource T_acento}"/>
          </Button>
        </Grid>
        <ProgressBar x:Name="BarraConf" Grid.ColumnSpan="6" Style="{StaticResource Progreso}" Value="{Binding Progreso, Mode=OneWay}" Foreground="{Binding EstadoColor}" VerticalAlignment="Bottom" Margin="0,0,0,2" Visibility="Collapsed"/>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding EsBase}" Value="True">
          <Setter TargetName="EtqBase" Property="Visibility" Value="Visible"/>
          <Setter TargetName="BotonRapido" Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Configurando}" Value="True">
          <Setter TargetName="BarraConf" Property="Visibility" Value="Visible"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding EsFc}" Value="True">
          <Setter TargetName="EtqFc" Property="Visibility" Value="Visible"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding EsDesechable}" Value="True">
          <Setter TargetName="EtqDesech" Property="Visibility" Value="Visible"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Encendida}" Value="True">
          <Setter TargetName="BtnTEnc" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="BtnTApa" Property="Visibility" Value="Visible"/>
          <DataTrigger.EnterActions>
            <BeginStoryboard x:Name="Latido">
              <Storyboard RepeatBehavior="Forever">
                <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="Opacity" From="0.6" To="0" Duration="0:0:1.4"/>
                <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1" To="2.6" Duration="0:0:1.4"/>
                <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="2.6" Duration="0:0:1.4"/>
              </Storyboard>
            </BeginStoryboard>
          </DataTrigger.EnterActions>
          <DataTrigger.ExitActions>
            <StopStoryboard BeginStoryboardName="Latido"/>
          </DataTrigger.ExitActions>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ===== Controles de la pantalla de Apariencia ===== -->
    <!-- Opción de un selector por segmentos (Claro / Oscuro / Automático...) -->
    <Style x:Key="Segmento" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource T_textoSuave}"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Caja" CornerRadius="9" Height="34" Margin="1" Background="Transparent">
              <Grid>
                <!-- El marcador es el fondo de la opción elegida; animaciones.ps1 lo desliza desde la opción anterior -->
                <Border x:Name="Marcador" CornerRadius="9" Background="{DynamicResource T_acento}" Opacity="0" RenderTransformOrigin="0,0.5">
                  <Border.RenderTransform><TransformGroup><ScaleTransform/><TranslateTransform/></TransformGroup></Border.RenderTransform>
                </Border>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Caja" Property="Background" Value="{DynamicResource T_linea}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Marcador" Property="Opacity" Value="1"/>
                <Setter Property="Foreground" Value="{DynamicResource T_sobreAcento}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Interruptor (encendido / apagado) -->
    <Style x:Key="Interruptor" TargetType="ToggleButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Width" Value="44"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Grid>
              <Border x:Name="Pista" CornerRadius="12" Background="{DynamicResource T_pista}"/>
              <Border x:Name="PistaOn" CornerRadius="12" Background="{DynamicResource T_acento}" Opacity="0"/>
              <Ellipse x:Name="Bola" Width="18" Height="18" Fill="#FFFFFF" HorizontalAlignment="Left" Margin="3,0,0,0" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
                <Ellipse.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.25" Color="#000000"/></Ellipse.Effect>
              </Ellipse>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Bola" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="20" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetName="PistaOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Bola" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetName="PistaOn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Muestra de color de acento (el color va en Background) -->
    <Style x:Key="Muestra" TargetType="RadioButton">
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Margin" Value="0,0,10,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid>
              <Ellipse x:Name="Anillo" Stroke="{DynamicResource T_texto}" StrokeThickness="2" Opacity="0"/>
              <Ellipse Fill="{TemplateBinding Background}" Margin="5"/>
              <Path x:Name="Visto" Data="M1 6l4.5 4.5L15 1.5" Stroke="#FFFFFF" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="16" Height="12" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Anillo" Property="Opacity" Value="1"/>
                <Setter TargetName="Visto" Property="Opacity" Value="1"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Anillo" Property="Opacity" Value="0.45"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Etiqueta" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource T_textoSuave}"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="Valor" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Foreground" Value="{DynamicResource T_texto}"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
  

  <!-- Tarjeta entera clicable (portada de Ajustes) -->
  <Style x:Key="TarjetaClic" TargetType="Button">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    <Setter Property="Padding" Value="18,16"/>
    <Setter Property="Margin" Value="0,0,12,12"/>
    <Setter Property="MinHeight" Value="132"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <!-- Como las tarjetas de «Mis máquinas»: al pasar el ratón se levanta 2 px y sale una sombra suave. Las dos capas de
               sombra van detrás de la tarjeta y se guardan como imagen (BitmapCache); solo cambia su transparencia -->
          <Grid x:Name="Caja">
            <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
            <Border CornerRadius="14" Background="{DynamicResource T_superficie}">
              <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.05" Color="#12261A"/></Border.Effect>
              <Border.CacheMode><BitmapCache/></Border.CacheMode>
            </Border>
            <Border x:Name="SombraHover" CornerRadius="14" Background="{DynamicResource T_superficie}" Opacity="0">
              <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.16" Color="#12261A"/></Border.Effect>
              <Border.CacheMode><BitmapCache/></Border.CacheMode>
            </Border>
            <Border x:Name="B" CornerRadius="14" Background="{DynamicResource T_superficie}" BorderBrush="{DynamicResource T_borde}" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </Border>
            <!-- Borde de acento al pasar el ratón (ficha 25): una capa propia encima del borde normal cuya opacidad se anima de 0 a 1
                 en 150 ms (no se anima el color del pincel, que es compartido). Una animación no puede leer un recurso: con animaciones
                 «Ninguna» se quita la capa animada y se enseña BordeInstante, que cambia de golpe (recursos Anim_VerFundido/Anim_VerInstante,
                 que pone Aplicar-Tema). En sobrio T_acento ya es gris. -->
            <Border x:Name="BordeHover" CornerRadius="14" BorderBrush="{DynamicResource T_acento}" BorderThickness="1" Opacity="0" IsHitTestVisible="False" Visibility="{DynamicResource Anim_VerFundido}"/>
            <Border x:Name="BordeInstante" CornerRadius="14" BorderBrush="{DynamicResource T_acento}" BorderThickness="1" Opacity="0" IsHitTestVisible="False" Visibility="{DynamicResource Anim_VerInstante}"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="BordeInstante" Property="Opacity" Value="1"/>
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="BordeHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                    <DoubleAnimation Storyboard.TargetName="SombraHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"/>
                    <DoubleAnimation Storyboard.TargetName="Caja" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-2" Duration="0:0:0.14">
                      <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="BordeHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                    <DoubleAnimation Storyboard.TargetName="SombraHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                    <DoubleAnimation Storyboard.TargetName="Caja" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.2">
                      <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource T_acento}"/>
              <Setter TargetName="B" Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="B" Property="Background" Value="{DynamicResource T_campo}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Tarjeta de sistema (selector de sistema): se elige como un botón de opción -->
  <Style x:Key="TarjetaSistema" TargetType="RadioButton">
    <Setter Property="Cursor" Value="Hand"/>
    <!-- La tarjeta mide 76 de alto y deja 10 de hueco; el control es más grande (6 por arriba y los lados, 10 por abajo) y se
         solapa con el hueco, para que lo que se salga de la tarjeta (levantarse al pasar el ratón, redondeos de píxel con escala
         125 %, sombra) no lo recorte el límite del control. Medidas: alto 92 = 6 + 76 + 10; margen -6 arriba y -6 a la izquierda. -->
    <Setter Property="Height" Value="92"/>
    <Setter Property="Margin" Value="-6,-6,4,0"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <!-- Como las tarjetas de «Mis máquinas»: al pasar el ratón se levanta y sale una sombra suave. Con redondeo de píxeles. Solo
               las dos capas de sombra se guardan como imagen (BitmapCache: la sombra es lo que más cuesta dibujar y hay muchas
               tarjetas); las líneas del borde NO, que con la pantalla al 125 % caían entre píxeles y se «cortaba» un borde -->
          <Grid x:Name="Caja" Margin="6,6,6,10" UseLayoutRounding="True" SnapsToDevicePixels="True">
            <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
            <Border CornerRadius="12" Background="{DynamicResource T_superficie}">
              <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.05" Color="#12261A"/></Border.Effect>
              <Border.CacheMode><BitmapCache/></Border.CacheMode>
            </Border>
            <Border x:Name="SombraHover" CornerRadius="12" Background="{DynamicResource T_superficie}" Opacity="0">
              <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.16" Color="#12261A"/></Border.Effect>
              <Border.CacheMode><BitmapCache/></Border.CacheMode>
            </Border>
            <Border x:Name="Fondo" CornerRadius="12" BorderBrush="{DynamicResource T_borde}" BorderThickness="1"/>
            <Border x:Name="FondoHover" CornerRadius="12" BorderBrush="{DynamicResource T_bordeHover}" BorderThickness="1" Opacity="0"/>
            <Border x:Name="Sel" CornerRadius="12" Background="{DynamicResource T_campo}" BorderBrush="{DynamicResource T_acento}" BorderThickness="2" Opacity="0"/>
            <Border x:Name="Marca" Width="4" HorizontalAlignment="Left" Margin="0,16" CornerRadius="0,3,3,0" Background="{DynamicResource T_acento}" Opacity="0"/>
            <ContentPresenter VerticalAlignment="Center" Margin="12,0"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="FondoHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"/>
                    <DoubleAnimation Storyboard.TargetName="SombraHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"/>
                    <DoubleAnimation Storyboard.TargetName="Caja" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-2" Duration="0:0:0.14">
                      <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="FondoHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                    <DoubleAnimation Storyboard.TargetName="SombraHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                    <DoubleAnimation Storyboard.TargetName="Caja" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.2">
                      <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Fondo" Property="BorderBrush" Value="{DynamicResource T_acento}"/></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                    <DoubleAnimation Storyboard.TargetName="Marca" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                    <DoubleAnimation Storyboard.TargetName="Marca" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Tarjeta de opción (dos o tres opciones con explicación, lado a lado) -->
  <Style x:Key="TarjetaOpcion" TargetType="RadioButton">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="B" CornerRadius="12" Background="{DynamicResource T_superficie}" BorderBrush="{DynamicResource T_borde}" BorderThickness="1" Padding="14,10">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource T_bordeHover}"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource T_acento}"/></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="B" Property="Background" Value="{DynamicResource T_campo}"/>
              <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource T_acento}"/>
              <Setter TargetName="B" Property="BorderThickness" Value="2"/>
              <Setter TargetName="B" Property="Padding" Value="13,9"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.5"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>

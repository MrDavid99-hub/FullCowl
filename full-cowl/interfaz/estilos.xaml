    <Setter Property="Foreground" Value="{DynamicResource T_texto}"/>
    <Setter Property="CaretBrush" Value="#39824D"/>
    <Setter Property="SelectionBrush" Value="#78EBDD"/>
    <Setter Property="MinHeight" Value="76"/>
    <Setter Property="MaxHeight" Value="170"/>
    <Setter Property="AcceptsReturn" Value="True"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="B" CornerRadius="8" Background="{DynamicResource T_superficie}" BorderBrush="{DynamicResource T_borde}" BorderThickness="1">
            <ScrollViewer x:Name="PART_ContentHost" Margin="8,6" Focusable="False"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource T_bordeHover}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource T_acento}"/>
              <Setter TargetName="B" Property="Effect">
                <Setter.Value>
                  <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#39824D" Opacity="0.28"/>
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="B" Property="Background" Value="{DynamicResource T_fondo}"/>
              <Setter Property="Foreground" Value="{DynamicResource T_placeholder}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>


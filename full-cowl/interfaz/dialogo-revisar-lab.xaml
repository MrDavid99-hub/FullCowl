<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560">
    <StackPanel Margin="24,14,24,18">
      <TextBlock Style="{StaticResource Rotulo}" Text="Nombre de la plantilla" Margin="0,0,0,5"/>
      <TextBox x:Name="RvNombre" Style="{StaticResource Campo}" MaxLength="60" HorizontalAlignment="Left" Width="320"/>
      <TextBlock x:Name="RvDescripcion" Style="{StaticResource Nota}" Margin="0,8,0,0" TextWrapping="Wrap"/>
      <TextBlock x:Name="RvResumen" FontSize="12.5" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource T_textoSuave}"/>
      <StackPanel x:Name="RvAvisos" Margin="0,12,0,0"/>
      <TextBlock Style="{StaticResource Rotulo}" Text="Cómo quedará" Margin="0,16,0,6"/>
      <Border CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource T_borde}" Background="{DynamicResource T_campo}" Padding="6">
        <ScrollViewer x:Name="RvMapaScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <Canvas x:Name="RvMapa" Width="780" Height="300" HorizontalAlignment="Center"/>
        </ScrollViewer>
      </Border>
      <TextBlock Style="{StaticResource Rotulo}" Text="Lo que hace falta en este PC" Margin="0,16,0,6"/>
      <StackPanel x:Name="RvRequisitos"/>
      <TextBlock x:Name="RvNota" Style="{StaticResource Nota}" Margin="0,12,0,0" TextWrapping="Wrap" Text="Al usar la plantilla se guarda entre las tuyas y se carga en «Crear laboratorio» para que la cambies. No se crea ni se enciende nada hasta que tú pulses «Crear»."/>
    </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="1" Background="{DynamicResource T_pie}" BorderBrush="{DynamicResource T_linea}" BorderThickness="0,1,0,0" CornerRadius="0,0,14,14" Padding="24,14">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="BtnRvNo" Style="{StaticResource BotonSecundario}" Content="Cancelar" MinWidth="104"/>
      <Button x:Name="BtnRvOk" Style="{StaticResource BotonPrimario}" Content="Usar esta plantilla" MinWidth="150" Margin="8,0,0,0" IsDefault="True"/>
    </StackPanel>
  </Border>
</Grid>

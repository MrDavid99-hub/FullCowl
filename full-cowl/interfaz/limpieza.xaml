<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="RaizEspacio">
  <!-- Ajustes → Espacio y limpieza (ficha 30). Las filas de las listas se pintan desde interfaz\limpieza.ps1 -->
  <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <!-- Cabecera -->
  <Grid Margin="0,4,8,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel>
      <TextBlock Text="Espacio y limpieza" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource T_texto}"/>
      <TextBlock x:Name="EspEstado" Foreground="{DynamicResource T_textoSuave}" Margin="0,4,0,0" TextWrapping="Wrap" Text="Qué ocupa cada base, máquina e instantánea, y qué se puede borrar sin romper nada."/>
    </StackPanel>
    <Button x:Name="BtnEspCalcular" Grid.Column="1" Style="{StaticResource BotonSecundario}" Tag="{StaticResource Ico_Actualizar}" Content="Volver a calcular" Height="34" VerticalAlignment="Top" Margin="12,4,0,0"/>
  </Grid>

  <!-- Disco -->
  <ContentControl Grid.Row="1" Style="{StaticResource Tarjeta}" Padding="18,14" Margin="0,14,8,0">
    <StackPanel>
      <TextBlock x:Name="EspDiscoTexto" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource T_texto}" TextWrapping="Wrap" Text="Leyendo el disco…"/>
      <Border CornerRadius="5" Height="10" Margin="0,10,0,0" Background="{DynamicResource T_pista}" ClipToBounds="True">
        <Grid x:Name="EspDiscoBarra">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0*"/>
            <ColumnDefinition Width="0*"/>
            <ColumnDefinition Width="1*"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="{DynamicResource T_acento}" CornerRadius="5,0,0,5"/>
          <Border Grid.Column="1" Background="{DynamicResource T_bordeFuerte}"/>
        </Grid>
      </Border>
      <ProgressBar x:Name="EspBarraCalc" Style="{StaticResource Progreso}" Height="5" Margin="0,8,0,0" Minimum="0" Maximum="100" Visibility="Collapsed"/>
      <WrapPanel Margin="0,10,0,0">
        <StackPanel Orientation="Horizontal" Margin="0,0,22,4">
          <Border Width="10" Height="10" CornerRadius="5" Background="{DynamicResource T_acento}" VerticalAlignment="Center"/>
          <TextBlock x:Name="EspCifFc" Margin="7,0,0,0" FontSize="12.5" Foreground="{DynamicResource T_textoSuave}" Text="Full Cowl"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,22,4">
          <Border Width="10" Height="10" CornerRadius="5" Background="{DynamicResource T_bordeFuerte}" VerticalAlignment="Center"/>
          <TextBlock x:Name="EspCifOtros" Margin="7,0,0,0" FontSize="12.5" Foreground="{DynamicResource T_textoSuave}" Text="Otros"/>
        </StackPanel>
        <TextBlock x:Name="EspCifBases" Margin="0,0,22,4" FontSize="12.5" Foreground="{DynamicResource T_texto}"/>
        <TextBlock x:Name="EspCifMaq" Margin="0,0,22,4" FontSize="12.5" Foreground="{DynamicResource T_texto}"/>
        <TextBlock x:Name="EspCifSnap" Margin="0,0,22,4" FontSize="12.5" Foreground="{DynamicResource T_texto}"/>
        <TextBlock x:Name="EspCifIso" Margin="0,0,0,4" FontSize="12.5" Foreground="{DynamicResource T_textoSuave}"/>
      </WrapPanel>
    </StackPanel>
  </ContentControl>

  <!-- Apartados -->
  <WrapPanel Grid.Row="2" Margin="0,14,8,6">
    <RadioButton x:Name="EspPillBases" Style="{StaticResource Chip}" GroupName="EspPill" Content="Bases" IsChecked="True"/>
    <RadioButton x:Name="EspPillMaq" Style="{StaticResource Chip}" GroupName="EspPill" Content="Máquinas"/>
    <RadioButton x:Name="EspPillSnap" Style="{StaticResource Chip}" GroupName="EspPill" Content="Instantáneas"/>
    <RadioButton x:Name="EspPillRestos" Style="{StaticResource Chip}" GroupName="EspPill" Content="Restos"/>
    <Button x:Name="BtnEspOrden" Style="{StaticResource BotonSecundario}" Content="Orden: tamaño" Height="30" Margin="14,0,0,0" ToolTip="Cambia entre ordenar por tamaño y por nombre"/>
    <Button x:Name="BtnEspTodosRestos" Style="{StaticResource BotonSecundario}" Content="Marcar todos los restos" Height="30" Margin="8,0,0,0" Visibility="Collapsed" ToolTip="Marca los restos claros: carpetas vacías o con sobras de VMware sin discos, restos de crear bases, CD ya usados, desechables apagadas y registros antiguos"/>
  </WrapPanel>

  <ScrollViewer x:Name="EspDesliz" Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="0,0,8,8">
    <StackPanel>
      <TextBlock x:Name="EspNota" Style="{StaticResource Nota}" TextWrapping="Wrap" Margin="2,0,0,8"/>
      <StackPanel x:Name="EspLista"/>
      <StackPanel x:Name="EspVacio" Visibility="Collapsed" Margin="0,26,0,0"/>
    </StackPanel>
  </ScrollViewer>

  <!-- Barra inferior -->
  <Border Grid.Row="4" Background="{DynamicResource T_pie}" BorderBrush="{DynamicResource T_linea}" BorderThickness="0,1,0,0" Padding="4,12,8,4" Margin="0,0,0,0">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="EspMarcado" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource T_texto}" Text="Nada marcado."/>
      <Button x:Name="BtnEspBorrar" Grid.Column="1" Style="{StaticResource BotonRojo}" Tag="{StaticResource Ico_Limpiar}" Content="Borrar lo marcado" Height="36" Margin="12,0,0,0" IsEnabled="False"/>
    </Grid>
  </Border>
</Grid>

<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="PaginaNueva">
  <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
  </Grid.RowDefinitions>

  <!-- Cabecera -->
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel>
      <TextBlock Style="{StaticResource TituloPagina}" Text="Nueva máquina"/>
      <TextBlock x:Name="NuevaResumen" Foreground="{DynamicResource T_textoSuave}" Margin="0,4,0,0" Text="Una máquina de práctica a partir de una base."/>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
      <Button x:Name="BtnNuevaRecargar" Style="{StaticResource BotonSecundario}" Width="38" Padding="0" ToolTip="Volver a leer las bases y las máquinas">
        <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Ico_Actualizar}" Width="18" Height="18" Foreground="{DynamicResource T_acento}"/>
      </Button>
      <Button x:Name="BtnCrearMaquina" Style="{StaticResource BotonPrimario}" Tag="{StaticResource Ico_Nueva}" Content="Crear máquina" Margin="8,0,0,0"/>
    </StackPanel>
  </Grid>

  <Grid Grid.Row="1" Margin="0,18,-10,0">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition x:Name="NuevaColGap" Width="18"/>
      <ColumnDefinition x:Name="NuevaColRes" Width="300"/>
    </Grid.ColumnDefinitions>

    <ScrollViewer Padding="0,0,10,0" VerticalScrollBarVisibility="Auto">
     <StackPanel x:Name="NuevaPila" Margin="0,2,0,0">
      <!-- Máquinas que se están configurando (o que acaban de terminar), con su contador -->
      <ContentControl x:Name="NuevaProgCaja" Style="{StaticResource Tarjeta}" Padding="22,18" Margin="0,0,0,18" Visibility="Collapsed">
        <StackPanel>
          <Grid>
            <TextBlock Style="{StaticResource TituloTarjeta}" Text="Configurándose"/>
            <TextBlock Style="{StaticResource Nota}" HorizontalAlignment="Right" Text="Una máquina se puede usar cuando pone «Lista para usar»"/>
          </Grid>
          <StackPanel x:Name="NuevaProgLista"/>
        </StackPanel>
      </ContentControl>
      <StackPanel x:Name="NuevaVacio" Visibility="Collapsed" Margin="0,60,0,0"/>

      <StackPanel x:Name="NuevaForm">
        <!-- 1. Base -->
        <ContentControl Style="{StaticResource Tarjeta}" Padding="22,18" Margin="0,0,0,18">
          <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource T_campo}" Margin="0,0,10,0">
              <TextBlock Text="1" FontWeight="SemiBold" Foreground="{DynamicResource T_acento}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Style="{StaticResource TituloTarjeta}" Text="Base" Margin="0" VerticalAlignment="Center"/>
          </StackPanel>
            <ComboBox x:Name="NuevaBase" Style="{StaticResource Combo}" Visibility="Collapsed"/>
            <StackPanel x:Name="NuevaSelector"/>
            <TextBlock x:Name="NuevaBaseNota" Style="{StaticResource Nota}" Margin="0,8,0,0"/>
            <Border x:Name="NuevaBaseAviso" Visibility="Collapsed" CornerRadius="10" Padding="12,10" Margin="0,10,0,0" Background="{DynamicResource T_avisoFondo}" BorderBrush="{DynamicResource T_avisoBorde}" BorderThickness="1">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="NuevaBaseAvisoTxt" Foreground="{DynamicResource T_avisoTexto}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <Button x:Name="BtnNuevaIrBase" Grid.Column="1" Style="{StaticResource BotonSecundario}" Content="Ir a Crear base" Height="30" Margin="12,0,0,0"/>
              </Grid>
            </Border>
          </StackPanel>
        </ContentControl>

        <!-- 2. Nombre -->
        <ContentControl Style="{StaticResource Tarjeta}" Padding="22,18" Margin="0,0,0,18">
          <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource T_campo}" Margin="0,0,10,0">
              <TextBlock Text="2" FontWeight="SemiBold" Foreground="{DynamicResource T_acento}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Style="{StaticResource TituloTarjeta}" Text="Nombre" Margin="0" VerticalAlignment="Center"/>
          </StackPanel>
            <TextBlock Style="{StaticResource Rotulo}" Text="Nombre"/>
            <TextBox x:Name="NuevaNombre" Style="{StaticResource Campo}"/>
            <TextBlock x:Name="NuevaNombreNota" Style="{StaticResource Nota}" Margin="0,5,0,0" Text="También será el nombre de su carpeta."/>
            <TextBlock Style="{StaticResource Rotulo}" Text="Nombre de equipo" Margin="0,14,0,5"/>
            <TextBox x:Name="NuevaHost" Style="{StaticResource Campo}" MaxLength="15"/>
            <TextBlock Style="{StaticResource Nota}" Margin="0,5,0,0" Text="Se rellena solo a partir del nombre · máximo 15 caracteres."/>
            <TextBlock Style="{StaticResource Rotulo}" Text="Etiquetas (opcional)" Margin="0,14,0,5"/>
            <ContentControl x:Name="NuevaHuecoEtq" Focusable="False" IsTabStop="False"/>
            <TextBlock Style="{StaticResource Nota}" Margin="0,5,0,0" Text="Sirven para encontrarla luego con el filtro de Mis máquinas. Pulsa Enter o escribe una coma para añadir cada una."/>
          </StackPanel>
        </ContentControl>

        <!-- 3. Copia y recursos -->
        <ContentControl Style="{StaticResource Tarjeta}" Padding="22,18" Margin="0,0,0,18">
          <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource T_campo}" Margin="0,0,10,0">
              <TextBlock Text="3" FontWeight="SemiBold" Foreground="{DynamicResource T_acento}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Style="{StaticResource TituloTarjeta}" Text="Copia y recursos" Margin="0" VerticalAlignment="Center"/>
          </StackPanel>
            <TextBlock Style="{StaticResource Rotulo}" Text="Tipo de copia"/>
            <UniformGrid Columns="2">
              <RadioButton x:Name="NuevaEnlazada" Style="{StaticResource TarjetaOpcion}" GroupName="CopiaNueva" IsChecked="True" Margin="0,0,5,0">
                <StackPanel>
                  <TextBlock Text="Enlazada" FontWeight="SemiBold" Foreground="{DynamicResource T_texto}"/>
                  <TextBlock Text="Se crea en segundos y ocupa poco. Necesita la base." FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource T_textoSuave}" Margin="0,2,0,0"/>
                </StackPanel>
              </RadioButton>
              <RadioButton x:Name="NuevaCompleta" Style="{StaticResource TarjetaOpcion}" GroupName="CopiaNueva" Margin="5,0,0,0">
                <StackPanel>
                  <TextBlock Text="Completa" FontWeight="SemiBold" Foreground="{DynamicResource T_texto}"/>
                  <TextBlock Text="Independiente de la base, pero ocupa más y tarda más." FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource T_textoSuave}" Margin="0,2,0,0"/>
                </StackPanel>
              </RadioButton>
            </UniformGrid>

            <Grid Margin="0,16,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource Rotulo}" Text="RAM (GB)"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Button x:Name="BtnNuevaRamMenos" Style="{StaticResource BotonSecundario}" Content="−" Width="30" Height="34" Padding="0"/>
                  <TextBox x:Name="NuevaRam" Grid.Column="1" Style="{StaticResource Campo}" TextAlignment="Center" Margin="4,0"/>
                  <Button x:Name="BtnNuevaRamMas" Grid.Column="2" Style="{StaticResource BotonSecundario}" Content="+" Width="30" Height="34" Padding="0"/>
                </Grid>
              </StackPanel>
              <StackPanel Grid.Column="2"><StackPanel>
                <TextBlock Style="{StaticResource Rotulo}" Text="Procesadores"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Button x:Name="BtnNuevaCpuMenos" Style="{StaticResource BotonSecundario}" Content="−" Width="30" Height="34" Padding="0"/>
                  <TextBox x:Name="NuevaCpu" Grid.Column="1" Style="{StaticResource Campo}" TextAlignment="Center" Margin="4,0"/>
                  <Button x:Name="BtnNuevaCpuMas" Grid.Column="2" Style="{StaticResource BotonSecundario}" Content="+" Width="30" Height="34" Padding="0"/>
                </Grid>
              </StackPanel></StackPanel>
              <StackPanel Grid.Column="4"><StackPanel>
                <TextBlock Style="{StaticResource Rotulo}" Text="Memoria 3D (MB)"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Button x:Name="BtnNuevaVramMenos" Style="{StaticResource BotonSecundario}" Content="−" Width="30" Height="34" Padding="0"/>
                  <TextBox x:Name="NuevaVram" Grid.Column="1" Style="{StaticResource Campo}" TextAlignment="Center" Margin="4,0"/>
                  <Button x:Name="BtnNuevaVramMas" Grid.Column="2" Style="{StaticResource BotonSecundario}" Content="+" Width="30" Height="34" Padding="0"/>
                </Grid>
              </StackPanel></StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource Nota}" Margin="0,8,0,0" Text="Memoria 3D: 0 = sin aceleración 3D."/>
            <!-- Ficha 36: zona horaria de esta máquina (el idioma viene de la base y no se cambia aquí) -->
            <StackPanel Margin="0,14,0,0">
              <TextBlock Style="{StaticResource Rotulo}" Text="Zona horaria"/>
              <ComboBox x:Name="NuevaZona" Style="{StaticResource Combo}" Width="340" HorizontalAlignment="Left"
                        ToolTip="Si la cambias, la máquina la pone ella sola al configurarse (sin reiniciar)"/>
              <TextBlock x:Name="NuevaIdiomaNota" Style="{StaticResource Nota}" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <CheckBox x:Name="NuevaDesechable" Style="{StaticResource Casilla}" Content="Desechable: se borra sola cuando la apagues" Margin="0,16,0,0"/>
            <CheckBox x:Name="NuevaArrancar" Style="{StaticResource Casilla}" Content="Arrancarla al terminar" Margin="0,10,0,0"/>
          </StackPanel>
        </ContentControl>

        <ContentControl x:Name="NuevaTarjetaRed" Style="{StaticResource Tarjeta}" Padding="22,18" Margin="0,0,0,18">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource T_campo}" Margin="0,0,10,0">
              <TextBlock Text="4" FontWeight="SemiBold" Foreground="{DynamicResource T_acento}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Style="{StaticResource TituloTarjeta}" Text="Red" Margin="0" VerticalAlignment="Center"/>
          </StackPanel>
            <CheckBox x:Name="NuevaIpFija" Style="{StaticResource Casilla}" Content="IP fija" FontWeight="Medium"/>
            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="60"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource Rotulo}" Text="IP"/>
                <TextBox x:Name="NuevaIp" Style="{StaticResource Campo}"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource Rotulo}" Text="Prefijo"/>
                <TextBox x:Name="NuevaPrefijo" Style="{StaticResource Campo}" Text="24"/>
              </StackPanel>
              <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Style="{StaticResource Rotulo}" Text="Puerta de enlace"/>
                  <TextBox x:Name="NuevaGw" Style="{StaticResource Campo}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Style="{StaticResource Rotulo}" Text="DNS (separados por comas)"/>
                  <TextBox x:Name="NuevaDns" Style="{StaticResource Campo}"/>
                </StackPanel>
              </Grid>
            </Grid>
            <TextBlock x:Name="NuevaRedNota" Style="{StaticResource Nota}" Margin="0,8,0,0"/>
          </StackPanel>
        </ContentControl>

        <ContentControl x:Name="NuevaTarjetaAd" Style="{StaticResource Tarjeta}" Padding="22,18" Margin="0,0,0,18">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource T_campo}" Margin="0,0,10,0">
              <TextBlock Text="5" FontWeight="SemiBold" Foreground="{DynamicResource T_acento}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Style="{StaticResource TituloTarjeta}" Text="Active Directory" Margin="0" VerticalAlignment="Center"/>
          </StackPanel>
            <ComboBox x:Name="NuevaAd" Style="{StaticResource Combo}"/>
            <StackPanel x:Name="NuevaAdCampos" Margin="0,12,0,0">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Style="{StaticResource Rotulo}" Text="Dominio"/>
                  <TextBox x:Name="NuevaDominio" Style="{StaticResource Campo}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Style="{StaticResource Rotulo}" Text="NetBIOS"/>
                  <TextBox x:Name="NuevaNetbios" Style="{StaticResource Campo}" MaxLength="15"/>
                </StackPanel>
              </Grid>
              <WrapPanel x:Name="NuevaDominiosConocidos" Margin="0,8,0,0"/>
              <StackPanel x:Name="NuevaDcCaja" Margin="0,10,0,0">
                <TextBlock Style="{StaticResource Rotulo}" Text="IP del controlador de dominio"/>
                <TextBox x:Name="NuevaDcIp" Style="{StaticResource Campo}"/>
              </StackPanel>
            </StackPanel>
            <TextBlock x:Name="NuevaAdNota" Style="{StaticResource Nota}" Margin="0,8,0,0"/>
          </StackPanel>
        </ContentControl>

        <ContentControl x:Name="NuevaTarjetaUbu" Style="{StaticResource Tarjeta}" Padding="22,18" Margin="0,0,0,18">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource T_campo}" Margin="0,0,10,0">
              <TextBlock Text="5" FontWeight="SemiBold" Foreground="{DynamicResource T_acento}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="NuevaUbuTitulo" Style="{StaticResource TituloTarjeta}" Text="Ubuntu" Margin="0" VerticalAlignment="Center"/>
          </StackPanel>
            <TextBlock Style="{StaticResource Nota}" FontSize="13" LineHeight="21"
                       Text="•  Usuario con sudo y SSH activado.&#10;•  El software marcado abajo se instala solo en el primer arranque, en segundo plano: puedes entrar mientras.&#10;•  Al terminar aparece ~/configuracion-vm.txt con el resumen."/>
          </StackPanel>
        </ContentControl>

        <ContentControl x:Name="NuevaTarjetaExtras" Style="{StaticResource Tarjeta}" Padding="22,18" Margin="0,0,0,28" >
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource T_campo}" Margin="0,0,10,0">
              <TextBlock Text="6" FontWeight="SemiBold" Foreground="{DynamicResource T_acento}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="NuevaExtrasTitulo" Style="{StaticResource TituloTarjeta}" Text="Extras (opcional)" Margin="0" VerticalAlignment="Center"/>
          </StackPanel>
          <DockPanel x:Name="NuevaExtrasPlegado" LastChildFill="True">
            <Button x:Name="BtnNuevaExtras" DockPanel.Dock="Right" Style="{StaticResource BotonSecundario}" Content="Elegir extras" Height="32" Margin="12,0,0,0" VerticalAlignment="Center"/>
            <TextBlock Style="{StaticResource Nota}" VerticalAlignment="Center" TextWrapping="Wrap" Text="Instala software al arrancar: Apache, bases de datos, roles de Windows… Si no marcas nada, la máquina sale en limpio."/>
          </DockPanel>
          <StackPanel x:Name="NuevaExtrasAbierto" Visibility="Collapsed">
            <CheckBox x:Name="NuevaActualizar" Style="{StaticResource Casilla}" Content="Actualizar el sistema en el primer arranque (tarda bastante más)" Margin="0,0,0,14" Visibility="Collapsed"/>
            <StackPanel x:Name="NuevaExtras"/>
          </StackPanel>
          <Border x:Name="NuevaSinAgente" Visibility="Collapsed" CornerRadius="10" Padding="12,10" Background="{DynamicResource T_avisoFondo}" BorderBrush="{DynamicResource T_avisoBorde}" BorderThickness="1">
            <TextBlock x:Name="NuevaSinAgenteTxt" Foreground="{DynamicResource T_avisoTexto}" TextWrapping="Wrap" Text="Esta base es de una versión anterior y no admite opciones extra (IP, servicios, dominio). Rehazla en «Crear base» para tenerlas. Solo se pondrá el nombre de equipo."/>
          </Border>
          <TextBlock x:Name="NuevaExtrasNota" Style="{StaticResource Nota}" Margin="0,10,0,0"/>
        </StackPanel>
      </ContentControl>
      </StackPanel>
     </StackPanel>
    </ScrollViewer>

    <!-- Resumen fijo -->
    <ScrollViewer x:Name="NuevaResHost" Grid.Column="2" Padding="0,0,10,0" VerticalScrollBarVisibility="Auto">
      <ContentControl x:Name="NuevaResTarjeta" Style="{StaticResource Tarjeta}" Padding="20,18" VerticalAlignment="Top" Margin="0,2,0,28">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ContentControl x:Name="NuevaResPastilla" VerticalAlignment="Center" Focusable="False" IsTabStop="False"/>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="NuevaResNombre" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource T_texto}" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="NuevaResSub" Style="{StaticResource Nota}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </Grid>
          <StackPanel x:Name="NuevaResLineas" Margin="0,16,0,0"/>
          <Rectangle Height="1" Fill="{DynamicResource T_linea}" Margin="0,12,0,12"/>
          <TextBlock x:Name="NuevaResEstimacion" TextWrapping="Wrap" Foreground="{DynamicResource T_texto}" FontSize="13"/>
          <TextBlock x:Name="NuevaResAviso" TextWrapping="Wrap" Foreground="{DynamicResource T_aviso}" FontSize="13" FontWeight="Medium" Margin="0,8,0,0" Visibility="Collapsed"/>
          <Rectangle Height="1" Fill="{DynamicResource T_linea}" Margin="0,12,0,12"/>
          <TextBlock Style="{StaticResource Rotulo}" Text="Comprobaciones" Margin="0,0,0,6"/>
          <StackPanel x:Name="NuevaResChecks"/>
          <Button x:Name="BtnCrearMaquina2" Style="{StaticResource BotonPrimario}" Tag="{StaticResource Ico_Nueva}" Content="Crear máquina" Margin="0,16,0,0" HorizontalAlignment="Stretch"/>
        </StackPanel>
      </ContentControl>
    </ScrollViewer>
  </Grid>
</Grid>

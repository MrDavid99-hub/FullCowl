<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="24,14,24,20">
    <TextBlock Style="{StaticResource Nota}" Text="Es la contraseña de las máquinas nuevas que crees en este PC. Las que ya existen conservan la suya. Windows Server es el más exigente (se marca abajo). No puede llevar comillas simples (')."/>
    <TextBlock Style="{StaticResource Rotulo}" Text="Contraseña nueva" Margin="0,16,0,5"/>
    <PasswordBox x:Name="PwUno" Style="{StaticResource CampoClave}"/>
    <TextBlock Style="{StaticResource Rotulo}" Text="Repítela" Margin="0,14,0,5"/>
    <PasswordBox x:Name="PwDos" Style="{StaticResource CampoClave}"/>
    <StackPanel Margin="0,14,0,0">
      <TextBlock x:Name="PwReg1" FontSize="12.5" Margin="0,0,0,3"/>
      <TextBlock x:Name="PwReg2" FontSize="12.5" Margin="0,0,0,3"/>
      <TextBlock x:Name="PwReg3" FontSize="12.5"/>
    </StackPanel>
    <TextBlock x:Name="PwError" Foreground="{DynamicResource T_peligro}" FontSize="12.5" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
  </StackPanel>
  <Border Grid.Row="1" Background="{DynamicResource T_pie}" BorderBrush="{DynamicResource T_linea}" BorderThickness="0,1,0,0" CornerRadius="0,0,14,14" Padding="24,14">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="BtnPwNo" Style="{StaticResource BotonSecundario}" Content="Cancelar" MinWidth="104"/>
      <Button x:Name="BtnPwOk" Style="{StaticResource BotonPrimario}" Content="Cambiar" MinWidth="104" Margin="8,0,0,0" IsDefault="True"/>
    </StackPanel>
  </Border>
</Grid>

<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="24,14,24,20">
    <Border CornerRadius="9" Background="{DynamicResource T_avisoFondo}" BorderBrush="{DynamicResource T_avisoBorde}" BorderThickness="1" Padding="12,9" Margin="0,0,0,14">
      <TextBlock Foreground="{DynamicResource T_avisoTexto}" FontWeight="Medium" TextWrapping="Wrap" Text="Se perderá todo lo hecho dentro de las máquinas desde que se creó el laboratorio. Las máquinas volverán exactamente a como estaban."/>
    </Border>

    <TextBlock Style="{StaticResource Rotulo}" Text="Máquinas del laboratorio"/>
    <StackPanel x:Name="VolverLista" Margin="0,4,0,0"/>

    <Border x:Name="VolverFaltanCaja" Visibility="Collapsed" CornerRadius="9" Background="{DynamicResource T_avisoFondo}" BorderBrush="{DynamicResource T_avisoBorde}" BorderThickness="1" Padding="12,9" Margin="0,12,0,0">
      <StackPanel>
        <TextBlock x:Name="VolverFaltan" Foreground="{DynamicResource T_avisoTexto}" TextWrapping="Wrap"/>
        <Button x:Name="BtnVolverGuardar" Style="{StaticResource BotonSecundario}" Content="Guardar su estado ahora" Height="30" HorizontalAlignment="Left" Margin="0,8,0,0" ToolTip="Guarda el estado de ahora como inicial solo en las máquinas que no lo tienen"/>
      </StackPanel>
    </Border>

    <CheckBox x:Name="ChkVolverEncender" Style="{StaticResource Casilla}" Content="Dejarlas encendidas al terminar" Margin="0,14,0,0"/>
    <TextBlock Style="{StaticResource Nota}" Margin="26,2,0,0" TextWrapping="Wrap" Text="Se apagan con cortesía (a la fuerza si tardan más de un minuto). Si se encienden, el controlador de dominio arranca primero. Full Cowl sigue aunque cierres esta ventana."/>
  </StackPanel>
  <Border Grid.Row="1" Background="{DynamicResource T_pie}" BorderBrush="{DynamicResource T_linea}" BorderThickness="0,1,0,0" CornerRadius="0,0,14,14" Padding="24,14">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="BtnVolverNo" Style="{StaticResource BotonSecundario}" Content="Cancelar" MinWidth="104"/>
      <Button x:Name="BtnVolverOk" Style="{StaticResource BotonRojo}" Tag="{StaticResource Ico_Deshacer}" Content="Volver al estado inicial" Margin="8,0,0,0"/>
    </StackPanel>
  </Border>
</Grid>
